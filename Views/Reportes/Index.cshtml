@{
    ViewData["Title"] = "Reportes";
    var empleados = ViewBag.Empleados as IEnumerable<PickingApp.Models.Empleado> ?? Enumerable.Empty<PickingApp.Models.Empleado>();
    var bodegas = ViewBag.Bodegas as IEnumerable<PickingApp.Models.Bodega> ?? Enumerable.Empty<PickingApp.Models.Bodega>();
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");

    // Control segmentado de dos opciones: la segunda revela un campo adicional
    void Segmentado(string nombre, string prefijo, string textoGeneral, string textoIndividual)
    {
        <div class="pf-segmented" role="radiogroup">
            <input type="radio" class="pf-seg-input" name="@nombre" id="@(prefijo)General" value="general" checked />
            <label for="@(prefijo)General">@textoGeneral</label>
            <input type="radio" class="pf-seg-input" name="@nombre" id="@(prefijo)Individual" value="individual" />
            <label for="@(prefijo)Individual">@textoIndividual</label>
        </div>
    }

    // Periodo común a todos los reportes: todo el historial o un rango (Desde obligatorio, Hasta opcional)
    void Periodo(string prefijo)
    {
        <fieldset class="pf-campo">
            <legend class="pf-campo-titulo">Periodo</legend>
            @{ Segmentado("_periodo", prefijo + "Periodo", "Todo el historial", "Rango de fechas"); }
            <div class="pf-dependiente row g-2" data-si="_periodo=individual" hidden>
                <div class="col-6">
                    <label class="form-label small fw-semibold mb-1" for="@(prefijo)Desde">Desde</label>
                    <input type="date" class="form-control" id="@(prefijo)Desde" name="fechaInicio" max="@hoy" required disabled data-fecha-desde />
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold mb-1" for="@(prefijo)Hasta">Hasta <span class="fw-normal text-secondary">(opcional)</span></label>
                    <input type="date" class="form-control" id="@(prefijo)Hasta" name="fechaFin" max="@hoy" disabled data-fecha-hasta />
                </div>
            </div>
        </fieldset>
    }
}

<h1 class="pf-page-title">Reportes</h1>

<div class="row g-4">
    <!-- Tarjeta destacada: reporte general del dashboard (cifras, gráfica configurable y pedidos recientes) -->
    <div class="col-lg-8">
        <div class="mockup-report-card pf-reporte-general">
            <div class="pf-reporte-general-texto">
                <h3>Reporte general del dashboard</h3>
                <p>Las cifras por estado, la gráfica que elijas con sus filtros y los últimos pedidos cargados.</p>
                <button type="button" class="btn-pf-blue py-2 px-4" data-bs-toggle="modal" data-bs-target="#modalReporteGeneral">
                    Configurar y generar PDF
                </button>
            </div>
            <div class="pf-reporte-general-iconos" aria-hidden="true">
                @foreach (var tipo in new[] { "doughnut", "bar", "line", "pie", "hbar", "area" })
                {
                    <span><partial name="_IconoTipoGrafica" model="tipo" /></span>
                }
            </div>
        </div>
    </div>

    <!-- Tarjeta 1: tiempos por empleado -->
    <div class="col-lg-4 col-md-6">
        <div class="mockup-report-card">
            <div>
                <h3>Tiempos por empleado</h3>
                <p>De todos los empleados o de uno solo, con el detalle de sus pedidos.</p>
            </div>
            <div>
                <button type="button" class="btn-pf-blue w-100 py-2" data-bs-toggle="modal" data-bs-target="#modalReporteEmpleados">
                    Generar PDF
                </button>
            </div>
        </div>
    </div>

    <!-- Tarjeta 2: tiempos de entrega -->
    <div class="col-lg-4 col-md-6">
        <div class="mockup-report-card">
            <div>
                <h3>Tiempos generales de entrega</h3>
                <p>Agrupados por bodega: todas o una en particular.</p>
            </div>
            <div>
                <button type="button" class="btn-pf-blue w-100 py-2" data-bs-toggle="modal" data-bs-target="#modalReporteEntrega">
                    Generar PDF
                </button>
            </div>
        </div>
    </div>

    <!-- Tarjeta 3: pedidos por periodo -->
    <div class="col-lg-4 col-md-6">
        <div class="mockup-report-card">
            <div>
                <h3>Pedidos por periodo</h3>
                <p>Pedidos cargados en todo el historial o entre fechas, por bodega.</p>
            </div>
            <div>
                <button type="button" class="btn-pf-blue w-100 py-2" data-bs-toggle="modal" data-bs-target="#modalReportePedidos">
                    Generar PDF
                </button>
            </div>
        </div>
    </div>

    <!-- Tarjeta 4: estado de pedidos -->
    <div class="col-lg-4 col-md-6">
        <div class="mockup-report-card">
            <div>
                <h3>Estado de pedidos</h3>
                <p>Completados, cancelados y reasignados, juntos o por separado.</p>
            </div>
            <div>
                <button type="button" class="btn-pf-blue w-100 py-2" data-bs-toggle="modal" data-bs-target="#modalReporteEstados">
                    Generar PDF
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ===== Diálogos de configuración de cada reporte ===== -->

<!-- Reporte general: las opciones de la izquierda se ven en vivo en la vista previa de la derecha (wwwroot/js/reporte-dashboard.js) -->
<div class="modal fade" id="modalReporteGeneral" tabindex="-1" aria-labelledby="tituloReporteGeneral" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form id="formReporteGeneral" method="post" asp-controller="Home" asp-action="ExportarDashboardPdf"
                  data-datos="@Url.Action("DatosGrafica", "Home")">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 class="modal-title fw-bold text-dark" id="tituloReporteGeneral">Reporte general del dashboard</h5>
                        <p class="pf-reporte-desc">Elige cómo se ve la gráfica del PDF. Las cifras por estado y los pedidos recientes siempre se incluyen.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="pf-rg">
                        <div class="pf-rg-opciones">
                            <fieldset class="pf-campo">
                                <legend class="pf-campo-titulo">Tipo de gráfica</legend>
                                <div class="pf-tipos pf-tipos--ancho" role="radiogroup" aria-label="Tipo de gráfica">
                                    @foreach (var (tipo, nombre) in new[] { ("doughnut", "Dona"), ("pie", "Pastel"), ("bar", "Barras"), ("hbar", "Horizontal"), ("line", "Líneas"), ("area", "Área") })
                                    {
                                        <label class="pf-tipo">
                                            <input type="radio" class="visually-hidden" name="tipo" value="@tipo" checked="@(tipo == "doughnut")" />
                                            <partial name="_IconoTipoGrafica" model="tipo" />
                                            <span>@nombre</span>
                                        </label>
                                    }
                                </div>
                            </fieldset>

                            <fieldset class="pf-campo">
                                <legend class="pf-campo-titulo">Agrupar por</legend>
                                <div class="pf-pildoras" role="radiogroup" aria-label="Agrupar por">
                                    @foreach (var (valor, nombre) in new[] { ("estado", "Estado"), ("prioridad", "Prioridad"), ("bodega", "Bodega"), ("empleado", "Empleado"), ("dia", "Día de carga") })
                                    {
                                        <label class="pf-pildora">
                                            <input type="radio" class="visually-hidden" name="agrupar" value="@valor" checked="@(valor == "estado")" />
                                            <span>@nombre</span>
                                        </label>
                                    }
                                </div>
                            </fieldset>

                            <fieldset class="pf-campo">
                                <legend class="pf-campo-titulo">Estados incluidos</legend>
                                <div class="pf-pildoras">
                                    @foreach (var (valor, nombre, color) in new[]
                                    {
                                        (PedidoEstados.Pendiente, "Pendientes", "#3B71CA"), (PedidoEstados.Asignado, "En proceso", "#EB7D26"),
                                        (PedidoEstados.Completado, "Completados", "#52A447"), (PedidoEstados.Cancelado, "Cancelados", "#DC2626"),
                                        (PedidoEstados.Reasignado, "Reasignados", "#1F2937")
                                    })
                                    {
                                        <label class="pf-pildora">
                                            <input type="checkbox" class="visually-hidden" data-estado value="@valor" checked />
                                            <span><i class="pf-kpi-dot" style="--dot: @color" aria-hidden="true"></i>@nombre</span>
                                        </label>
                                    }
                                </div>
                            </fieldset>

                            <div class="row g-2">
                                <div class="col-sm-4">
                                    <label class="pf-campo-titulo d-block" for="rgDias">Periodo</label>
                                    <select class="form-select" id="rgDias" name="dias">
                                        <option value="0">Todo</option>
                                        <option value="7">Últimos 7 días</option>
                                        <option value="30">Últimos 30 días</option>
                                        <option value="90">Últimos 90 días</option>
                                    </select>
                                </div>
                                <div class="col-sm-4">
                                    <label class="pf-campo-titulo d-block" for="rgBodega">Bodega</label>
                                    <select class="form-select" id="rgBodega" name="bodegaId">
                                        <option value="">Todas</option>
                                        @foreach (var b in bodegas)
                                        {
                                            <option value="@b.Id">@b.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-sm-4">
                                    <label class="pf-campo-titulo d-block" for="rgPrioridad">Prioridad</label>
                                    <select class="form-select" id="rgPrioridad" name="prioridad">
                                        <option value="">Todas</option>
                                        <option>Alta</option>
                                        <option>Media</option>
                                        <option>Baja</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <section class="pf-rg-vista" aria-labelledby="rgVistaTitulo">
                            <div class="pf-rg-vista-etiqueta">Vista previa</div>
                            <h6 class="pf-rg-vista-titulo" id="rgVistaTitulo">Pedidos por estado</h6>
                            <p class="pf-rg-vista-resumen" id="rgResumen" aria-live="polite">&nbsp;</p>
                            <div class="pf-rg-lienzo">
                                <canvas id="rgGrafica" role="img" aria-label="Vista previa de la gráfica del reporte"></canvas>
                                <div class="pf-chart-center" id="rgCentro"></div>
                            </div>
                            <div class="pf-chart-empty" id="rgVacio" hidden>No hay pedidos con estos filtros.</div>
                        </section>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <p class="pf-rg-error me-auto" id="rgError" role="alert" hidden></p>
                    <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-pf-blue" id="rgGenerar"><i class="bi bi-file-earmark-pdf me-1" aria-hidden="true"></i>Generar PDF</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalReporteEmpleados" tabindex="-1" aria-labelledby="tituloReporteEmpleados" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="TiemposPorEmpleado" method="get" data-reporte-form>
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 class="modal-title fw-bold text-dark" id="tituloReporteEmpleados">Tiempos por empleado</h5>
                        <p class="pf-reporte-desc">Elige si el reporte incluye a todos los empleados o solo a uno.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <fieldset class="pf-campo">
                        <legend class="pf-campo-titulo">Empleados</legend>
                        @{ Segmentado("_alcance", "emp", "Todos", "Un empleado"); }
                        <div class="pf-dependiente" data-si="_alcance=individual" hidden>
                            <label class="visually-hidden" for="empSelect">Empleado</label>
                            <select class="form-select" id="empSelect" name="empleadoId" required disabled>
                                <option value="">Selecciona un empleado…</option>
                                @foreach (var e in empleados)
