@model PickingApp.Models.ViewModels.ConfiguracionViewModel
@using PickingApp.Services
@{
    ViewData["Title"] = "Configuración del Sistema";

    // Valor, rango y paso salen de ParametrosSistema: la vista no repite valores por defecto ni límites
    void Numero(string clave, string etiqueta)
    {
        var p = ParametrosSistema.Numericos[clave];
        <label for="cfg-@(clave)" class="form-label fw-semibold">@etiqueta</label>
        <input type="number" id="cfg-@(clave)" name="configuraciones[@clave]" value="@Formato.ParaInput(Model.Valores[clave])" class="form-control"
               min="@Formato.ParaInput(p.Minimo)" max="@Formato.ParaInput(p.Maximo)" step="@(p.Entero ? "1" : "0.1")" />
    }
}

<h1 class="pf-page-title">Configuración</h1>
<div class="pf-form-ancho">
    <div>
        <div>
            <div class="pf-card">
                <p class="pf-seccion-desc mb-4">Parámetros de auditoría, seguridad y asignación de PickFlow.</p>
                <div>
                    <form asp-action="GuardarConfiguracion" method="post">
                        @Html.AntiForgeryToken()

                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-journal-text me-1"></i> Auditoría y Registro (LOG)</h6>
                        <div class="mb-4">
                            <label for="cfgLogHabilitado" class="form-label fw-semibold">Registro de LOG Habilitado</label>
                            <select id="cfgLogHabilitado" name="configuraciones[@ParametrosSistema.LogHabilitado]" class="form-select">
                                <option value="true" selected="@Model.LogHabilitado">Habilitado (Recomendado)</option>
                                <option value="false" selected="@(!Model.LogHabilitado)">Deshabilitado</option>
                            </select>
                            <div class="form-text small">Permite habilitar o deshabilitar temporalmente la captura de eventos en la tabla de logs.</div>
                        </div>

                        <hr class="my-4" />

                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-shield-check me-1"></i> Parámetros de Seguridad y Sesión</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                @{ Numero(ParametrosSistema.MinutosInactividadSesion, "Cierre de Sesión por Inactividad (Minutos)"); }
                                <div class="form-text small">Estándar reglamentario: 10 minutos. Aplica desde el siguiente inicio de sesión de cada usuario.</div>
                            </div>
                            <div class="col-md-6">
                                @{ Numero(ParametrosSistema.MaxIntentosFallidos, "Intentos Fallidos antes de Bloqueo"); }
                                <div class="form-text small">Estándar reglamentario: 5 intentos consecutivos.</div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-cpu me-1"></i> Reglas de Asignación y Operación</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                @{ Numero(ParametrosSistema.MargenInicioMinutos, "Margen de Inicio (Minutos)"); }
                                <div class="form-text small">Margen reglamentario: 2 min.</div>
                            </div>
                            <div class="col-md-4">
                                @{ Numero(ParametrosSistema.MesesExperienciaAdvertencia, "Meses Exp. para Advertencia"); }
                            </div>
                            <div class="col-md-4">
                                @{ Numero(ParametrosSistema.MaxUbicacionesAdvertencia, "Ubicaciones para Advertencia"); }
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                @{ Numero(ParametrosSistema.MaxHorasJornada, "Máximo Horas de Jornada Laboral"); }
                                <div class="form-text small">Un turno no podrá superar esta cantidad de horas.</div>
                            </div>
                            <div class="col-md-4">
                                @{ Numero(ParametrosSistema.MinutosPorUbicacion, "Minutos de Recorrido por Ubicación"); }
                                <div class="form-text small">Se suman al tiempo estándar por cada ubicación del pedido. Los minutos por unidad se definen en <a asp-controller="Productos" asp-action="Index">Productos</a>.</div>
                            </div>
                            <div class="col-md-4">
                                @{ Numero(ParametrosSistema.MinPedidosRendimiento, "Pedidos para Medir Rendimiento"); }
                                <div class="form-text small">Pedidos completados que necesita un empleado antes de ajustar su tiempo estimado; con menos se usa el tiempo estándar.</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            @* Datos de prueba: borra solo los pedidos para repetir cargas de Excel y asignaciones *@
            <div class="card border-0 shadow-sm rounded-4 mt-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-trash3 me-1" aria-hidden="true"></i> Historial de pedidos</h6>
                    <p class="text-secondary small mb-3">
                        Borra todos los pedidos con sus productos y novedades para repetir pruebas desde cero.
                        Se conservan usuarios, empleados, bodegas, ubicaciones, productos, solicitudes y el LOG.
                    </p>
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <span class="fw-semibold">
                            @(Model.TotalPedidos == 0 ? "No hay pedidos registrados." : Model.TotalPedidos == 1 ? "1 pedido registrado" : $"{Model.TotalPedidos} pedidos registrados")
                        </span>
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalBorrarPedidos"
                                disabled="@(Model.TotalPedidos == 0)">
                            Borrar historial de pedidos…
                        </button>
                    </div>
                </div>
            </div>

            @* Demostración: simula unos días de uso (Services/DatosDemostracion.cs) sobre un historial vacío *@
            <div class="card border-0 shadow-sm rounded-4 mt-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-stars me-1" aria-hidden="true"></i> Datos de demostración</h6>
                    <p class="text-secondary small mb-3">
                        Simula @PickingApp.Services.DatosDemostracion.DiasSimulados días de uso hasta hoy: cargas de Excel, pedidos asignados,
                        reasignados, completados, cancelados y divididos, novedades y solicitudes. Las cantidades y los tiempos cambian
                        cada vez, pero siempre aparece cada caso. Los pedidos se reparten entre las bodegas activas que tengan ubicaciones
                        activas con producto. Para quitarlos, borre el historial de pedidos (las solicitudes se conservan).
                    </p>
                    <form asp-action="CargarDatosDemostracion" method="post" id="formDemostracion"
                          class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <span class="small @(Model.MotivoSinDemostracion == null ? "fw-semibold" : "text-secondary")">
                            @(Model.MotivoSinDemostracion ?? "Listo para cargar.")
                        </span>
                        <button type="submit" class="btn btn-outline-primary" disabled="@(Model.MotivoSinDemostracion != null)">
                            Cargar datos de demostración
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Generar la demostración tarda unos segundos: el botón lo indica y evita un doble envío
    document.getElementById('formDemostracion').addEventListener('submit', function (e) {
        var boton = e.target.querySelector('[type="submit"]');
        boton.disabled = true;
        boton.innerHTML = '<span class="pf-spinner" aria-hidden="true"></span>Cargando…';
    });
</script>

@if (Model.TotalPedidos > 0)
{
    <div class="modal fade" id="modalBorrarPedidos" tabindex="-1" aria-labelledby="tituloBorrarPedidos" aria-describedby="textoBorrarPedidos" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 p-2">
                <form asp-action="EliminarHistorialPedidos" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold" id="tituloBorrarPedidos">¿Borrar el historial de pedidos?</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body" id="textoBorrarPedidos">
                        <p class="mb-2">
                            Se borrarán @(Model.TotalPedidos == 1 ? "1 pedido" : $"los {Model.TotalPedidos} pedidos") con sus productos y novedades@(Model.PedidosEnCurso == 1 ? ", incluido 1 en curso" : Model.PedidosEnCurso > 1 ? $", incluidos {Model.PedidosEnCurso} en curso" : "").
                        </p>
                        <p class="mb-0 fw-semibold">Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer border-0">
                        @* Cancelar recibe el foco al abrir: la acción destructiva nunca es la predeterminada *@
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-pf-foco>Cancelar</button>
                        <button type="submit" class="btn btn-danger" data-borrar-pedidos>
                            Borrar @(Model.TotalPedidos == 1 ? "1 pedido" : $"{Model.TotalPedidos} pedidos")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var modal = document.getElementById('modalBorrarPedidos');
            modal.addEventListener('shown.bs.modal', function () {
                modal.querySelector('[data-pf-foco]').focus();
            });
            // Evita un doble envío mientras se borran los pedidos
            modal.querySelector('form').addEventListener('submit', function () {
                var boton = modal.querySelector('[data-borrar-pedidos]');
                boton.disabled = true;
                boton.textContent = 'Borrando…';
            });
        })();
    </script>
}