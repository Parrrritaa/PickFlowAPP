@model PickingApp.Models.ViewModels.ConfiguracionViewModel
@using PickingApp.Services
@{
    ViewData["Title"] = "Configuración del Sistema";

    // Valor, rango y paso salen de ParametrosSistema: la vista no repite valores por defecto ni límites
    void Numero(string clave)
    {
        var p = ParametrosSistema.Numericos[clave];
        <input type="number" name="configuraciones[@clave]" value="@Formato.ParaInput(Model.Valores[clave])" class="form-control"
               min="@Formato.ParaInput(p.Minimo)" max="@Formato.ParaInput(p.Maximo)" step="@(p.Entero ? "1" : "0.1")" />
    }
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-primary">
                        <i class="bi bi-sliders me-2"></i> Configuración de Parámetros y Auditoría (CU-39, RNF-07)
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="GuardarConfiguracion" method="post">
                        @Html.AntiForgeryToken()

                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-journal-text me-1"></i> Auditoría y Registro (LOG)</h6>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Registro de LOG Habilitado</label>
                            <select name="configuraciones[@ParametrosSistema.LogHabilitado]" class="form-select">
                                <option value="true" selected="@Model.LogHabilitado">Habilitado (Recomendado)</option>
                                <option value="false" selected="@(!Model.LogHabilitado)">Deshabilitado</option>
                            </select>
                            <div class="form-text small">Permite habilitar o deshabilitar temporalmente la captura de eventos en la tabla de logs.</div>
                        </div>

                        <hr class="my-4" />

                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-shield-check me-1"></i> Parámetros de Seguridad y Sesión</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Cierre de Sesión por Inactividad (Minutos)</label>
                                @{ Numero(ParametrosSistema.MinutosInactividadSesion); }
                                <div class="form-text small">Estándar reglamentario: 10 minutos. Aplica desde el siguiente inicio de sesión de cada usuario.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Intentos Fallidos antes de Bloqueo</label>
                                @{ Numero(ParametrosSistema.MaxIntentosFallidos); }
                                <div class="form-text small">Estándar reglamentario: 5 intentos consecutivos.</div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-cpu me-1"></i> Reglas de Asignación y Operación</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Margen de Inicio (Minutos)</label>
                                @{ Numero(ParametrosSistema.MargenInicioMinutos); }
                                <div class="form-text small">Margen reglamentario: 2 min.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Meses Exp. para Advertencia</label>
                                @{ Numero(ParametrosSistema.MesesExperienciaAdvertencia); }
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Ubicaciones para Advertencia</label>
                                @{ Numero(ParametrosSistema.MaxUbicacionesAdvertencia); }
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Máximo Horas de Jornada Laboral</label>
                                @{ Numero(ParametrosSistema.MaxHorasJornada); }
                                <div class="form-text small">Un turno no podrá superar esta cantidad de horas.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Minutos de Recorrido por Ubicación</label>
                                @{ Numero(ParametrosSistema.MinutosPorUbicacion); }
                                <div class="form-text small">Se suman al tiempo estándar por cada ubicación del pedido. Los minutos por unidad se definen en <a asp-controller="Productos" asp-action="Index">Productos</a>.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Pedidos para Medir Rendimiento</label>
                                @{ Numero(ParametrosSistema.MinPedidosRendimiento); }
                                <div class="form-text small">Pedidos completados que necesita un empleado antes de ajustar su tiempo estimado; con menos se usa el tiempo estándar.</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>