@model IEnumerable<PickingApp.Models.LogSistema>
@{
    ViewData["Title"] = "LOG del sistema";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
    <h1 class="pf-page-title mb-0">LOG del sistema</h1>
    <div class="d-flex gap-2">
        <a asp-action="ExportarPdf" asp-route-modulo="@ViewBag.ModuloFiltro" asp-route-usuario="@ViewBag.UsuarioFiltro" asp-route-fecha="@ViewBag.FechaFiltro" class="btn btn-outline-secondary">
            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Exportar a PDF
        </a>
        <a asp-action="Configuracion" class="btn btn-outline-secondary">
            <i class="bi bi-gear-fill me-1"></i> Configuración
        </a>
        <a asp-action="LimpiarBaseDatos" class="btn btn-danger">
            <i class="bi bi-trash3-fill me-1"></i> Limpiar base de datos
        </a>
    </div>
</div>

<div class="mockup-card">
    <div class="table-responsive">
        <table class="mockup-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Accion</th>
                    <th>Descripcion</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var l in Model)
                    {
                        var usuarioDisplay = l.Usuario.Contains("@") ? l.Usuario.Split('@')[0] : l.Usuario;
                        usuarioDisplay = char.ToUpper(usuarioDisplay[0]) + usuarioDisplay.Substring(1);

                        <tr>
                            <td>@l.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-semibold">@usuarioDisplay</td>
                            <td>@l.Accion</td>
                            <td>@l.Detalle</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No hay registros de LOG para los filtros seleccionados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>