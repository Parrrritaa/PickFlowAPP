@{
    ViewData["Title"] = "Limpiar Base de Datos";
}

<h1 class="pf-page-title">Limpiar base de datos</h1>
<div class="pf-form-ancho">
    <div>
        <div>
            <div class="pf-card">
                <div>
                    <div class="alert alert-danger" role="alert">
                        <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-octagon-fill me-1"></i> Advertencia de Función Administrativa y de Pruebas</h6>
                        <p class="small mb-0">
                            Esta función está restringida exclusivamente al Administrador y se mantendrá principalmente para pruebas del proyecto universitario. 
                            <strong>Eliminará todos los pedidos, líneas de productos, novedades, solicitudes y notificaciones</strong>, dejando la base de datos lista para una nueva simulación.
                            El LOG del sistema se conserva, salvo que marque la opción de limpiarlo.
                        </p>
                    </div>

                    <p class="small text-muted">
                        Los usuarios del sistema (Administradores, Supervisores, Auxiliares) y las bodegas y ubicaciones maestras <strong>NO</strong> serán eliminados.
                    </p>

                    <form asp-action="ConfirmarLimpiezaBaseDatos" method="post">
                        @Html.AntiForgeryToken()

                        <div class="pf-opcion-limpieza mb-4">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" name="limpiarLog" value="true" id="limpiarLog" aria-describedby="ayudaLimpiarLog" />
                                <label class="form-check-label fw-semibold" for="limpiarLog">Limpiar también el LOG del sistema</label>
                            </div>
                            <div id="ayudaLimpiarLog" class="form-text ms-5">
                                Borra todo el historial de auditoría. Solo quedará el registro de esta limpieza.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="confirmacionLimpieza" class="form-label fw-semibold text-danger">
                                Para confirmar, escriba exactamente <span class="badge bg-danger">LIMPIAR_SISTEMA</span>:
                            </label>
                            <input type="text" name="confirmacion" id="confirmacionLimpieza" class="form-control" placeholder="LIMPIAR_SISTEMA" required autocomplete="off" spellcheck="false" aria-describedby="ayudaLimpieza" />
                            <div id="ayudaLimpieza" class="form-text">El botón se habilita cuando el texto coincide exactamente.</div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger pf-btn-habilitable" id="btnLimpiarBd">
                                <i class="bi bi-trash3-fill me-1"></i> Ejecutar Limpieza de BD
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Validación en vivo: el botón destructivo solo se habilita con la frase exacta (el servidor también la valida)
        (function () {
            var input = document.getElementById('confirmacionLimpieza');
            var btn = document.getElementById('btnLimpiarBd');
            var frase = 'LIMPIAR_SISTEMA';

            function actualizar() {
                var coincide = input.value === frase;
                btn.disabled = !coincide;
                input.classList.toggle('is-valid', coincide);
            }

            input.addEventListener('input', actualizar);
            actualizar();
        })();
    </script>
}
