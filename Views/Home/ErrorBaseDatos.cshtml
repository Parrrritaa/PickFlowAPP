@model ErrorBaseDatosViewModel
@{
    // Layout sin menú: el menú principal consulta la base de datos y fallaría de nuevo
    Layout = "_LayoutLogin";
    ViewData["Title"] = Model.SinConexion ? "Sin conexión con la base de datos" : "No se pudo completar la operación";
}

<main class="pf-login-card pf-aviso-bd">
    <div class="pf-aviso-bd-icono" aria-hidden="true">
        <i class="bi @(Model.SinConexion ? "bi-database-x" : "bi-exclamation-triangle")"></i>
    </div>

    <h1 class="pf-aviso-bd-titulo">@ViewData["Title"]</h1>

    @if (Model.SinConexion)
    {
        <p class="pf-aviso-bd-texto">
            PickFlow no puede comunicarse con el servidor de base de datos, así que por ahora no es posible consultar ni guardar información.
        </p>
        <p class="pf-aviso-bd-ayuda">
            Espera unos minutos y vuelve a intentarlo. Si el problema continúa, avisa al administrador del sistema.
        </p>
    }
    else
    {
        <p class="pf-aviso-bd-texto">
            Ocurrió un problema al consultar o guardar la información en la base de datos, y la acción no se completó.
        </p>
        <p class="pf-aviso-bd-ayuda">
            Vuelve a intentarlo. Si el problema continúa, avisa al administrador del sistema.
        </p>
    }

    <a href="@Model.UrlReintento" class="btn-pf-login">Reintentar</a>
</main>
