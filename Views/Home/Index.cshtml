@model PickingApp.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    // Franja de estados (los números llegan en el DashboardViewModel desde HomeController.Index); el color es el mismo de la gráfica
    var estados = new (string Clave, string Nombre, int Total, string Color)[]
    {
        (PickingApp.Models.PedidoEstados.Pendiente, "Pendientes", Model.TotalPendientes, "#3B71CA"),
        (PickingApp.Models.PedidoEstados.Asignado, "En proceso", Model.TotalEnProceso, "#EB7D26"),
        (PickingApp.Models.PedidoEstados.Completado, "Completados", Model.TotalCompletados, "#52A447"),
        (PickingApp.Models.PedidoEstados.Cancelado, "Cancelados", Model.TotalCancelados, "#DC2626"),
        (PickingApp.Models.PedidoEstados.Reasignado, "Reasignados", Model.TotalReasignados, "#1F2937")
    };
    var porAtender = Model.TotalPendientes + Model.TotalEnProceso + Model.TotalReasignados;
    var hoy = DateTime.Now.ToString("dddd d 'de' MMMM", System.Globalization.CultureInfo.GetCultureInfo("es-CO"));
    hoy = char.ToUpper(hoy[0]) + hoy[1..];

    var coloresEstado = estados.ToDictionary(e => e.Clave, e => e.Color);
}

<div class="pf-dash-head">
    <div>
        @* Easter egg: al tocar el título suena una trompeta (wwwroot/js/dashboard-sonido.js) *@
        <h1 class="pf-page-title" id="pfDashTitulo" data-sonido="@Url.Content("~/audio/trompeta-dashboard.mp3")">Dashboard</h1>
        <p class="pf-dash-sub">
            @hoy ·
            @(porAtender == 0 ? "no hay pedidos por atender" : porAtender == 1 ? "1 pedido por atender" : $"{porAtender} pedidos por atender")
        </p>
    </div>
</div>

<!-- Estados: cada uno muestra u oculta su estado en la gráfica -->
<div class="pf-kpis" id="pfEstados" role="group" aria-label="Pedidos por estado. Pulse un estado para mostrarlo u ocultarlo en la gráfica">
    @foreach (var e in estados)
    {
        <button type="button" class="pf-kpi @(e.Total == 0 ? "is-zero" : "")" data-estado="@e.Clave" aria-pressed="true"
                title="Mostrar u ocultar en la gráfica">
            <span class="pf-kpi-label">
                <i class="pf-kpi-dot" style="--dot: @e.Color" aria-hidden="true"></i>@e.Nombre
                <i class="bi bi-eye-slash pf-kpi-oculto" aria-hidden="true"></i>
            </span>
            <span class="pf-kpi-valor" data-valor="@e.Total">@e.Total</span>
        </button>
    }
</div>

<div class="row g-4">
    <!-- Gráfica configurable (wwwroot/js/dashboard-grafica.js, datos de HomeController.DatosGrafica) -->
    <div class="col-lg-7">
        <div class="mockup-card h-100 pf-chart-card" id="pfGrafica" data-url="@Url.Action("DatosGrafica", "Home")">
            <div class="pf-chart-head">
                <div class="pf-chart-titulo">
                    <h2 class="pf-chart-h">
                        <label for="pfAgrupar">Pedidos por</label>
                        <span class="pf-select-titulo dropdown">
                            <!-- El select guarda el valor que lee el script; el menú es solo la cara visible -->
                            <select id="pfAgrupar" hidden>
                                <option value="estado">estado</option>
                                <option value="prioridad">prioridad</option>
                                <option value="bodega">bodega</option>
                                <option value="empleado">empleado</option>
                                <option value="dia">día de carga</option>
                            </select>
                            <button type="button" class="pf-agrupar-btn" id="pfAgruparBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                <span id="pfAgruparTexto">estado</span>
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </button>
                            <div class="dropdown-menu pf-pop pf-opciones" id="pfAgruparMenu" aria-labelledby="pfAgruparBtn">
                                <button type="button" class="pf-opcion" data-valor="estado">estado</button>
                                <button type="button" class="pf-opcion" data-valor="prioridad">prioridad</button>
                                <button type="button" class="pf-opcion" data-valor="bodega">bodega</button>
                                <button type="button" class="pf-opcion" data-valor="empleado">empleado</button>
                                <button type="button" class="pf-opcion" data-valor="dia">día de carga</button>
                            </div>
                        </span>
                    </h2>
                    <p class="pf-chart-resumen" id="pfResumen" aria-live="polite">&nbsp;</p>
                </div>

                <div class="pf-chart-tools">
                    <!-- Tipo de gráfica: el botón muestra la elegida; el menú, todas con una vista previa -->
                    <div class="dropdown">
                        <button type="button" class="pf-tool-btn" id="pfTipoBtn" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="pf-tipo-icono" id="pfTipoIcono" aria-hidden="true"></span>
                            <span id="pfTipoNombre">Dona</span>
                            <i class="bi bi-chevron-down pf-tool-chevron" aria-hidden="true"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end pf-pop" aria-labelledby="pfTipoBtn">
                            <div class="pf-pop-titulo">Tipo de gráfica</div>
                            <div class="pf-tipos" id="pfTipos">
                                <button type="button" class="pf-tipo active" data-tipo="doughnut" aria-pressed="true">
                                    <partial name="_IconoTipoGrafica" model='"doughnut"' />
                                    <span>Dona</span>
                                </button>
                                <button type="button" class="pf-tipo" data-tipo="pie" aria-pressed="false">
                                    <partial name="_IconoTipoGrafica" model='"pie"' />
                                    <span>Pastel</span>
                                </button>
                                <button type="button" class="pf-tipo" data-tipo="bar" aria-pressed="false">
                                    <partial name="_IconoTipoGrafica" model='"bar"' />
                                    <span>Barras</span>
                                </button>
                                <button type="button" class="pf-tipo" data-tipo="hbar" aria-pressed="false">
                                    <partial name="_IconoTipoGrafica" model='"hbar"' />
                                    <span>Horizontal</span>
                                </button>
                                <button type="button" class="pf-tipo" data-tipo="line" aria-pressed="false">
                                    <partial name="_IconoTipoGrafica" model='"line"' />
                                    <span>Líneas</span>
                                </button>
                                <button type="button" class="pf-tipo" data-tipo="area" aria-pressed="false">
                                    <partial name="_IconoTipoGrafica" model='"area"' />
                                    <span>Área</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Filtros secundarios: el número dice cuántos hay activos -->
                    <div class="dropdown">
                        <button type="button" class="pf-tool-btn" id="pfFiltrosBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="bi bi-sliders" aria-hidden="true"></i>
                            <span>Filtros</span>
                            <span class="pf-tool-cuenta" id="pfFiltrosCuenta" hidden></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end pf-pop pf-pop-filtros" aria-labelledby="pfFiltrosBtn">
                            <label class="pf-pop-campo">Periodo
                                <select id="pfDias" class="form-select form-select-sm">
                                    <option value="0">Todo</option>
                                    <option value="7">Últimos 7 días</option>
                                    <option value="30">Últimos 30 días</option>
                                    <option value="90">Últimos 90 días</option>
                                </select>
                            </label>
                            <label class="pf-pop-campo">Bodega
                                <select id="pfBodega" class="form-select form-select-sm">
                                    <option value="">Todas</option>
                                    @foreach (var b in Model.Bodegas)
                                    {
                                        <option value="@b.Id">@b.Nombre</option>
                                    }
                                </select>
                            </label>
                            <label class="pf-pop-campo">Prioridad
                                <select id="pfPrioridad" class="form-select form-select-sm">
                                    <option value="">Todas</option>
                                    <option>Alta</option>
                                    <option>Media</option>
                                    <option>Baja</option>
                                </select>
                            </label>
                            <button type="button" class="pf-link-btn" id="pfLimpiar" disabled>Limpiar filtros</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pf-chart-body" id="pfCuerpo">
                <div class="pf-chart-canvas"><canvas id="detallesChart" role="img" aria-label="Gráfica de pedidos"></canvas><div class="pf-chart-center" id="pfCentro"></div></div>
                <div class="pf-legend" id="pfLeyenda"></div>
                <div class="pf-chart-empty" id="pfVacio" hidden>No hay pedidos con estos filtros.</div>
                <div class="pf-chart-table" id="pfTabla" hidden></div>
            </div>

            <div class="pf-chart-foot">
                <button type="button" class="pf-link-btn" id="pfVerTabla">Ver como tabla</button>
            </div>
        </div>
    </div>

    <!-- Últimos pedidos cargados (el modelo que envía HomeController.Index) -->
    <div class="col-lg-5">
        <div class="mockup-card h-100">
            <div class="pf-card-head">
                <h2 class="pf-card-h">Pedidos recientes</h2>
                <a asp-controller="Pedidos" asp-action="Index" class="pf-link-btn">Ver todos <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
            </div>
            <div class="table-responsive">
                <table class="mockup-table pf-recientes">
                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Estado</th>
                            <th>Empleado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.UltimosPedidos.Any())
                        {
                            @foreach (var pedido in Model.UltimosPedidos)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Pedidos" asp-action="Detalle" asp-route-id="@pedido.Id" class="pf-recientes-codigo">@pedido.CodigoPedido</a>
                                        <div class="pf-recientes-prioridad">Prioridad @pedido.Prioridad.ToLowerInvariant()</div>
                                    </td>
                                    <td>
                                        <span class="pf-pedido-estado" style="--dot: @(coloresEstado.GetValueOrDefault(pedido.Estado, "#6B7280"))">@pedido.Estado</span>
                                    </td>
                                    <td class="@(pedido.Empleado == null ? "pf-sin-asignar" : "")">@(pedido.Empleado?.NombreCompleto ?? "Sin asignar")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">No hay pedidos registrados</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
    <script src="~/js/grafica-pedidos.js" asp-append-version="true"></script>
    <script src="~/js/dashboard-grafica.js" asp-append-version="true"></script>
    <script src="~/js/dashboard-sonido.js" asp-append-version="true"></script>
}
