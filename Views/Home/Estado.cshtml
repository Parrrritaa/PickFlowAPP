@model int
@{
    // Destino de UseStatusCodePagesWithReExecute (Program.cs); Model es el código de la respuesta.
    // Al Supervisor y al Auxiliar, un registro de otra bodega responde 404 igual que uno que no existe (AlcanceBodega).
    var conSesion = User.Identity?.IsAuthenticated == true;
    var conBodega = conSesion && !User.IsInRole(Roles.Administrador);
    var (titulo, texto) = Model == 404
        ? (conBodega ? "No encontramos esto o no pertenece a tu bodega" : "No encontramos esto",
           conBodega ? "Puede que el enlace esté incompleto, que el registro se haya eliminado o que sea de otra bodega."
                     : "Puede que el enlace esté incompleto o que el registro se haya eliminado.")
        : ("No se pudo abrir esta página", "Vuelve al inicio y entra de nuevo desde el menú.");
    ViewData["Title"] = titulo;
    if (!conSesion)
    {
        Layout = "_LayoutLogin";
    }
}

@if (conSesion)
{
    <div class="pf-card pf-acceso-denegado pf-pantalla-estado">
        <div class="pf-notif-empty-icon" aria-hidden="true"><i class="bi bi-search"></i></div>
        <h1 class="pf-notif-empty-title">@titulo</h1>
        <p class="pf-notif-empty-text">@texto</p>
        <a asp-controller="Home" asp-action="Index" class="btn-pf-orange mt-2">Volver al inicio</a>
    </div>
}
else
{
    <main class="pf-login-card pf-aviso-bd">
        <div class="pf-aviso-bd-icono" aria-hidden="true"><i class="bi bi-search"></i></div>
        <h1 class="pf-aviso-bd-titulo">@titulo</h1>
        <p class="pf-aviso-bd-texto">@texto</p>
        <a asp-controller="Account" asp-action="Login" class="btn-pf-login">Iniciar sesión</a>
    </main>
}
