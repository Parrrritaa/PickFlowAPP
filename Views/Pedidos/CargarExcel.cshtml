@* Modelo: observaciones de la última carga rechazada; null si no hubo errores *@
@model List<string>
@{
    ViewData["Title"] = "Cargar archivo Excel";
    var errores = Model;
}

<h1 class="pf-page-title">Cargar archivo Excel</h1>

<div class="mockup-card">
    <form asp-action="CargarExcel" method="post" enctype="multipart/form-data" id="formExcel">
        @Html.AntiForgeryToken()

        <div class="mockup-upload-box mb-4">
            <h3 class="fw-bold text-dark mb-2">Seleccionar archivo Excel</h3>
            <p class="text-secondary mb-4">Cargue el archivo previamente creado con los pedidos.</p>

            <div class="d-flex justify-content-center align-items-center mb-4">
                <input type="file" name="archivoExcel" id="archivoExcel" class="form-control" accept=".xlsx" style="max-width: 420px;" required />
            </div>

            <button type="button" class="btn-pf-blue px-4 py-2" id="btnValidar">
                Validar archivo
            </button>
        </div>

        @if (errores != null && errores.Any())
        {
            <div class="mockup-alert-warning mb-4">
                <strong>Observaciones de validación encontradas:</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var err in errores)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }

        <!-- Resultado de validación (diapositiva 11): lo calcula el servidor con las mismas reglas de la carga -->
        <div id="sectionValidacion" hidden class="mt-4 pt-3 border-top" aria-live="polite">
            <h4 class="fw-bold text-dark mb-3">Resultado de validación</h4>
            <ul class="list-unstyled d-flex flex-column gap-2 mb-3" id="listaVerificaciones"></ul>
            <p class="fw-semibold mb-3" id="resumenValidacion"></p>
            <div class="mockup-alert-warning mb-4" id="erroresValidacion" hidden>
                <strong>Corrija estas filas y vuelva a validar:</strong>
                <ul class="mb-0 mt-2" id="listaErroresValidacion"></ul>
            </div>

            <!-- Productos no registrados o fuera de su ubicación: el usuario decide de dónde se recogen -->
            <div id="seccionIncidencias" class="mb-4" hidden>
                <h5 class="fw-bold text-dark mb-1">Decida qué hacer con estas filas</h5>
                <p class="text-secondary small mb-3">Los productos y ubicaciones nuevos se registran al confirmar la carga.</p>
                <div class="d-flex flex-column gap-3" id="listaIncidencias"></div>
            </div>

            <button type="submit" class="btn-pf-blue px-4 py-2" id="btnConfirmarCarga" hidden>
                Confirmar carga de pedidos
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/paginas/cargar-excel.js" asp-append-version="true" data-url-validar="@Url.Action("ValidarExcel")" data-max-unidades="@Producto.MaxUnidadesPorCaja"></script>
}
