@* Modelo: observaciones de la última carga rechazada; null si no hubo errores *@
@model List<string>
@{
    ViewData["Title"] = "Cargar archivo Excel";
    var errores = Model;
}

<h1 class="pf-page-title">Cargar archivo Excel</h1>

<div class="pf-card">
    <form asp-action="CargarExcel" method="post" enctype="multipart/form-data" id="formExcel">
        @Html.AntiForgeryToken()

        @* Zona de carga: grande y centrada al entrar (se puede arrastrar el archivo encima); al validar se compacta
           en una fila (.is-compacta, cargar-excel.js) para dejar a la vista el resultado y el botón de confirmar *@
        <div class="pf-upload-box" id="cajaArchivo">
            <span class="pf-upload-box__icono" aria-hidden="true"><i class="bi bi-file-earmark-spreadsheet"></i></span>
            <div class="pf-upload-box__texto">
                <h3 class="pf-upload-box__titulo" id="tituloArchivo">Arrastra aquí el archivo Excel</h3>
                <p class="pf-upload-box__ayuda" id="ayudaArchivo" aria-live="polite">o elígelo desde tu equipo. Formato .xlsx, con las columnas de la plantilla de pedidos.</p>
            </div>
            <div class="pf-upload-box__acciones">
                <input type="file" name="archivoExcel" id="archivoExcel" class="pf-upload-box__input" accept=".xlsx" required aria-describedby="ayudaArchivo" />
                <label for="archivoExcel" class="btn-pf-gray px-4 py-2 mb-0" id="btnElegirArchivo">
                    <i class="bi bi-folder2-open me-1" aria-hidden="true"></i>Elegir archivo
                </label>
                <button type="button" class="btn-pf-blue px-4 py-2" id="btnValidar">
                    Validar archivo
                </button>
            </div>
        </div>

        @if (errores != null && errores.Any())
        {
            <div class="pf-alert-warning mb-4">
                <strong>Observaciones de validación encontradas:</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var err in errores)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }

        <!-- Resultado de validación (diapositiva 11): lo calcula el servidor con las mismas reglas de la carga -->
        <div id="sectionValidacion" hidden class="mt-4 pt-3 border-top" aria-live="polite">
            <h4 class="fw-bold text-dark mb-3">Resultado de validación</h4>
            <ul class="list-unstyled pf-verificaciones mb-3" id="listaVerificaciones"></ul>
            <div class="pf-alert-warning mb-4" id="erroresValidacion" hidden>
                <strong>Corrija estas filas y vuelva a validar:</strong>
                <ul class="mb-0 mt-2" id="listaErroresValidacion"></ul>
            </div>

            <!-- Productos no registrados o fuera de su ubicación: el usuario decide de dónde se recogen -->
            <div id="seccionIncidencias" class="mb-4" hidden>
                <h5 class="fw-bold text-dark mb-1">Decida qué hacer con estas filas</h5>
                <p class="text-secondary small mb-3">Los productos y ubicaciones nuevos se registran al confirmar la carga.</p>
                <div class="d-flex flex-column gap-3" id="listaIncidencias"></div>
            </div>

            @* Resumen y confirmación en una barra pegada al borde de la pantalla (la de "Guardar cambios"):
               se ve sin bajar, aunque haya muchas filas por decidir *@
            <div class="pf-barra-guardar">
                <span id="resumenValidacion"></span>
                <button type="submit" class="btn-pf-blue px-4 py-2 text-nowrap" id="btnConfirmarCarga" hidden>
                    Confirmar carga de pedidos
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/paginas/cargar-excel.js" asp-append-version="true" data-url-validar="@Url.Action("ValidarExcel")" data-max-unidades="@Producto.MaxUnidadesPorCaja"></script>
}
