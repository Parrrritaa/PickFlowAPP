@model IEnumerable<PickingApp.Models.Empleado>
@{
    var pedido = ViewBag.Pedido as PickingApp.Models.Pedido;
    ViewData["Title"] = "Asignar pedido";
    var totalUbicaciones = pedido?.Detalles?.Select(d => d.UbicacionId).Distinct().Count() ?? 0;
    var tieneEmpleadoPocaExp = Model.Any(e => e.TieneMenosDeSeisMeses);
    var empleadoPocaExp = Model.FirstOrDefault(e => e.TieneMenosDeSeisMeses);
    var tiemposEstimados = ViewBag.TiemposEstimados as Dictionary<int, double> ?? new Dictionary<int, double>();
    var motivosNoAsignable = ViewBag.MotivosNoAsignable as Dictionary<int, string> ?? new Dictionary<int, string>();
    var empleadoRecomendadoId = ViewBag.EmpleadoRecomendadoId as int?;
    var tiempoEstandar = ViewBag.TiempoEstandar as double? ?? 0;
    var rendimientos = ViewBag.Rendimientos as Dictionary<int, PickingApp.Services.RendimientoEmpleado> ?? new Dictionary<int, PickingApp.Services.RendimientoEmpleado>();
    var minimoPedidos = rendimientos.Values.FirstOrDefault()?.MinimoPedidos ?? 3;
}

<h1 class="pf-page-title">Asignar pedido</h1>

<div class="mockup-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0" style="color: #1F2937;">Empleados disponibles</h4>
        <span class="text-muted fw-semibold">Pedido: <strong>@(pedido?.CodigoPedido)</strong> &bull; Ubicaciones: <strong>@totalUbicaciones</strong> &bull; Tiempo estándar: <strong>@PickingApp.Services.Formato.Duracion(tiempoEstandar)</strong></span>
    </div>

    <div class="table-responsive mb-3">
        <table class="mockup-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Estado</th>
                    <th>Experiencia</th>
                    <th>Turno</th>
                    <th>Rendimiento</th>
                    <th>Tiempo estimado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var emp in Model)
                    {
                        var highlightClass = emp.Id == empleadoRecomendadoId ? "mockup-row-highlight" : "";
                        var estadoText = motivosNoAsignable.TryGetValue(emp.Id, out var motivo)
                            ? motivo
                            : (emp.EstadoDisponibilidad == "Disponible" ? "Libre" : emp.EstadoDisponibilidad);
                        var tiempoEstimado = tiemposEstimados.TryGetValue(emp.Id, out var minutos) ? PickingApp.Services.Formato.Duracion(minutos) : "-";

                        <tr class="@highlightClass">
                            <td class="fw-semibold">@emp.NombreCompleto</td>
                            <td>@estadoText</td>
                            <td>@emp.MesesExperiencia meses</td>
                            <td>@(string.IsNullOrEmpty(emp.JornadaLaboral) ? "Sin turno asignado" : emp.JornadaLaboral)</td>
                            <td>
                                @if (rendimientos.TryGetValue(emp.Id, out var rendimiento))
                                {
                                    <span class="pf-rendimiento @ClaseRendimiento(rendimiento)">@rendimiento.Descripcion</span>
                                    <div class="small text-muted">@rendimiento.Detalle</div>
                                }
                            </td>
                            <td>@tiempoEstimado</td>
                            <td class="text-center">
                                <form asp-action="Asignar" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="pedidoId" value="@pedido?.Id" />
                                    <input type="hidden" name="empleadoId" value="@emp.Id" />
                                    <input type="hidden" name="ignorarAdvertencia" value="true" />
                                    <button type="submit" class="btn-pf-blue" style="padding: 4px 18px; font-size: 14px;">
                                        Asignar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay empleados registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="pf-seccion-desc small mb-3">
        Tiempo estimado = tiempo estándar del pedido × rendimiento del empleado (su tiempo real frente al estándar en sus pedidos completados).
        Con menos de @minimoPedidos pedidos completados se usa el tiempo estándar.
    </p>

    @if (tieneEmpleadoPocaExp && totalUbicaciones > 10)
    {
        <div class="mockup-alert-warning">
            <strong>Advertencia:</strong> @(empleadoPocaExp?.NombreCompleto ?? "El empleado") tiene menos de 6 meses de experiencia y el pedido contiene mas de 10 ubicaciones
        </div>
        <div class="text-muted small mt-1">
            La advertencia no bloquea la asignación.
        </div>
    }

    <div class="mt-4 pt-2">
        <a asp-action="Detalle" asp-route-id="@pedido?.Id" class="btn-pf-gray">
            Volver al pedido
        </a>
    </div>
</div>

@functions {
    // Verde si tarda menos que el estándar, ámbar si tarda más, neutro sin historial o al ritmo estándar
    string ClaseRendimiento(PickingApp.Services.RendimientoEmpleado r)
    {
        if (!r.TieneHistorialSuficiente || Math.Abs(1 - r.Factor) < 0.05) return "pf-rendimiento--neutro";
        return r.Factor < 1 ? "pf-rendimiento--rapido" : "pf-rendimiento--lento";
    }
}
