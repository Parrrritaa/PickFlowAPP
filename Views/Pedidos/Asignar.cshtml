@model PickingApp.Models.ViewModels.AsignarPedidoViewModel
@{
    var pedido = Model.Pedido;
    var empleados = Model.Empleados;
    var totalUbicaciones = pedido.Detalles.Select(d => d.UbicacionId).Distinct().Count();
    var validaciones = Model.Validaciones;
    var empleadoRecomendadoId = Model.EmpleadoRecomendadoId;
    var tiempoEstandar = Model.TiempoEstandar;
    var minimoPedidos = validaciones.Values.FirstOrDefault(v => v.Rendimiento != null)?.Rendimiento!.MinimoPedidos ?? 3;
    // CU-27: con un empleado ya asignado, la vista reasigna (motivo obligatorio) en lugar de asignar
    var empleadoActualId = Model.EmpleadoActualId;
    // La advertencia de experiencia la decide el motor para cada empleado asignable
    var conAdvertencia = empleados
        .Where(e => e.Id != empleadoActualId && validaciones.TryGetValue(e.Id, out var v) && v.PuedeAsignar && v.GeneraAdvertencia)
        .ToList();
    var empleadoActualNombre = Model.EmpleadoActualNombre;
    var esReasignacion = empleadoActualId.HasValue;
    ViewData["Title"] = esReasignacion ? "Reasignar pedido" : "Asignar pedido";
}

<h1 class="pf-page-title">@ViewData["Title"]</h1>

<div class="mockup-card">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="fw-bold mb-0" style="color: #1F2937;">Empleados disponibles</h4>
        <span class="text-muted fw-semibold">Pedido: <strong>@(pedido?.CodigoPedido)</strong> &bull; Ubicaciones: <strong>@totalUbicaciones</strong> &bull; Tiempo estándar: <strong>@PickingApp.Services.Formato.Duracion(tiempoEstandar)</strong></span>
    </div>

    @if (esReasignacion)
    {
        <p class="pf-seccion-desc mb-3">
            Asignado actualmente a <strong>@(empleadoActualNombre ?? "un empleado")</strong>. Al reasignarlo, ese empleado queda libre y el pedido pasa a estado Reasignado.
        </p>
    }

    <div class="table-responsive mb-3">
        <table class="mockup-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Estado</th>
                    <th>Experiencia</th>
                    <th>Turno</th>
                    <th>Rendimiento</th>
                    <th>Tiempo estimado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (empleados.Any())
                {
                    @foreach (var emp in empleados)
                    {
                        var highlightClass = emp.Id == empleadoRecomendadoId ? "mockup-row-highlight" : "";
                        validaciones.TryGetValue(emp.Id, out var validacion);
                        var estadoText = emp.Id == empleadoActualId ? "Asignado actualmente"
                            : validacion?.PuedeAsignar == true ? "Libre"
                            : validacion?.MotivoCorto ?? "No disponible";
                        var rendimiento = validacion?.Rendimiento;
                        var tiempoEstimado = rendimiento != null ? PickingApp.Services.Formato.Duracion(validacion!.TiempoEstimadoMinutos) : "-";

                        <tr class="@highlightClass">
                            <td class="fw-semibold">@emp.NombreCompleto</td>
                            <td>@estadoText</td>
                            <td>@emp.MesesExperiencia meses</td>
                            <td>@emp.JornadaLaboral</td>
                            <td>
                                @if (rendimiento != null)
                                {
                                    <span class="pf-rendimiento @ClaseRendimiento(rendimiento)">@rendimiento.Descripcion</span>
                                    <div class="small text-muted">@rendimiento.Detalle</div>
                                }
                            </td>
                            <td>@tiempoEstimado</td>
                            <td class="text-center">
                                @if (emp.Id == empleadoActualId)
                                {
                                    <span class="text-muted small fw-semibold">Actual</span>
                                }
                                else if (esReasignacion)
                                {
                                    <button type="button" class="btn-pf-orange" style="padding: 4px 18px; font-size: 14px;"
                                            data-bs-toggle="modal" data-bs-target="#modalReasignar"
                                            data-empleado-id="@emp.Id" data-empleado-nombre="@emp.NombreCompleto">
                                        Reasignar
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="Asignar" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="pedidoId" value="@pedido?.Id" />
                                        <input type="hidden" name="empleadoId" value="@emp.Id" />
                                        <button type="submit" class="btn-pf-blue" style="padding: 4px 18px; font-size: 14px;">
                                            Asignar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay empleados registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="pf-seccion-desc small mb-3">
        Tiempo estimado = tiempo estándar del pedido × rendimiento del empleado (su tiempo real frente al estándar en sus pedidos completados).
        Con menos de @minimoPedidos pedidos completados se usa el tiempo estándar.
    </p>

    @if (conAdvertencia.Any())
    {
        <div class="mockup-alert-warning">
            <strong>Advertencia:</strong> @string.Join(", ", conAdvertencia.Select(e => e.NombreCompleto)): @validaciones[conAdvertencia[0].Id].MotivoAdvertencia.
        </div>
        <div class="text-muted small mt-1">
            La advertencia no bloquea la asignación.
        </div>
    }

    <div class="mt-4 pt-2">
        <a asp-action="Detalle" asp-route-id="@pedido?.Id" class="btn-pf-gray">
            Volver al pedido
        </a>
    </div>
</div>

@if (esReasignacion)
{
    <!-- Modal Reasignar (CU-27): el motivo es obligatorio -->
    <div class="modal fade" id="modalReasignar" tabindex="-1" aria-labelledby="modalReasignarTitulo" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 border-0 p-2">
                <form asp-action="Reasignar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pedidoId" value="@pedido?.Id" />
                    <input type="hidden" name="nuevoEmpleadoId" id="reasignarEmpleadoId" value="" />
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold text-dark" id="modalReasignarTitulo">Reasignar a <span id="reasignarEmpleadoNombre"></span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3">
                            El pedido <strong>@(pedido?.CodigoPedido)</strong> dejará de estar a cargo de <strong>@(empleadoActualNombre ?? "el empleado actual")</strong>.
                        </p>
                        <label for="motivoReasignacion" class="form-label fw-bold">Motivo de reasignación (obligatorio):</label>
                        <textarea name="motivoReasignacion" id="motivoReasignacion" class="form-control" rows="3" maxlength="250" required
                                  placeholder="Especifique el motivo de la reasignación"></textarea>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-pf-orange">Reasignar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // El nombre viaja en un data-attribute y se escribe con textContent (nunca como código JS)
        (function () {
            var modal = document.getElementById('modalReasignar');
            if (!modal) return;
            var motivo = document.getElementById('motivoReasignacion');
            modal.addEventListener('show.bs.modal', function (e) {
                var boton = e.relatedTarget;
                if (!boton) return;
                document.getElementById('reasignarEmpleadoId').value = boton.getAttribute('data-empleado-id');
                document.getElementById('reasignarEmpleadoNombre').textContent = boton.getAttribute('data-empleado-nombre');
                motivo.value = '';
            });
            modal.addEventListener('shown.bs.modal', function () { motivo.focus(); });
        })();
    </script>
}

@functions {
    // Verde si tarda menos que el estándar, ámbar si tarda más, neutro sin historial o al ritmo estándar
    string ClaseRendimiento(PickingApp.Services.RendimientoEmpleado r)
    {
        if (!r.TieneHistorialSuficiente || Math.Abs(1 - r.Factor) < 0.05) return "pf-rendimiento--neutro";
        return r.Factor < 1 ? "pf-rendimiento--rapido" : "pf-rendimiento--lento";
    }
}
