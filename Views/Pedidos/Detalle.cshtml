@model PickingApp.Models.Pedido
@{
    ViewData["Title"] = $"Pedido {Model.CodigoPedido}";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Auxiliar";
    var totalUbicaciones = Model.Detalles.Select(d => d.UbicacionId).Distinct().Count();
    var tiempoEstandar = ViewBag.TiempoEstandar as double? ?? 0;
    var maxHorasJornada = ViewBag.MaxHorasJornada as double? ?? 9.0;
    var categoriaPredeterminada = ViewBag.CategoriaPredeterminada as string ?? "Predeterminada";
    var superaJornada = tiempoEstandar > maxHorasJornada * 60;
    var partesSugeridas = Math.Max(2, (int)Math.Ceiling(tiempoEstandar / (maxHorasJornada * 60)));
    var esDividido = Model.EstaDividido;
    var partes = Model.Partes.OrderBy(pa => pa.NumeroParte).ToList();
    var tiemposPartes = ViewBag.TiemposPartes as Dictionary<int, double> ?? new Dictionary<int, double>();
    var partesTerminadas = partes.Count(pa => pa.EstaFinalizado);
    var puedeDividir = Model.MotivoNoDivisible() == null;
    var puedeDeshacerDivision = Model.PuedeDeshacerDivision;
    var esGestor = userRole == "Administrador" || userRole == "Supervisor";
    if (totalUbicaciones == 0) totalUbicaciones = Model.Detalles.Count;
    const int productosVisibles = 5;
    var productosOcultos = Math.Max(0, Model.Detalles.Count - productosVisibles);
    var pasillosPedido = Model.Detalles
        .Where(d => d.Ubicacion != null)
        .Select(d => d.Ubicacion!.Pasillo)
        .Distinct()
        .OrderBy(x => int.TryParse(x, out var n) ? n : int.MaxValue)
        .ToList();
}

<h1 class="pf-page-title">Pedido @Model.CodigoPedido</h1>

@if (Model.PedidoPadre != null)
{
    <div class="pf-banner-parte mb-3">
        <i class="bi bi-diagram-3" aria-hidden="true"></i>
        <span>
            Parte @Model.NumeroParte de @Model.PedidoPadre.Partes.Count del pedido
            <a asp-action="Detalle" asp-route-id="@Model.PedidoPadreId">@Model.PedidoPadre.CodigoPedido</a>
        </span>
    </div>
}

<div class="mockup-card">
    <!-- 4 White Stat Cards matching Slide 7 -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="bg-white rounded-4 p-3 text-center shadow-sm h-100">
                <div class="text-secondary fw-semibold small mb-1">Estado</div>
                <div class="fw-bold fs-3" style="color: #3B71CA;">@Model.Estado</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white rounded-4 p-3 text-center shadow-sm h-100">
                <div class="text-secondary fw-semibold small mb-1">Prioridad</div>
                <div class="fw-bold fs-3 text-dark">@Model.Prioridad</div>
                @if (userRole == "Administrador")
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-1" data-bs-toggle="modal" data-bs-target="#modalPrioridad">
                        Cambiar
                    </button>
                }
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white rounded-4 p-3 text-center shadow-sm h-100">
                <div class="text-secondary fw-semibold small mb-1">Ubicaciones</div>
                <div class="fw-bold fs-3 text-dark">@totalUbicaciones</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white rounded-4 p-3 text-center shadow-sm h-100">
                <div class="text-secondary fw-semibold small mb-1">Empleado</div>
                <div class="fw-bold fs-3 text-dark">@(esDividido ? "Por partes" : Model.Empleado?.NombreCompleto ?? "Sin asignar")</div>
            </div>
        </div>
    </div>

    <!-- Información section -->
    <div class="mb-4">
        <h5 class="fw-bold mb-2 text-dark">Información</h5>
        <div class="fs-6">
            <strong>Bodega:</strong>
            @if (Model.Bodega != null)
            {
                @Model.Bodega.Nombre <span class="text-secondary">(@Model.Bodega.Codigo)</span>
            }
            else
            {
                <span class="fst-italic" style="color: #4B5563;">Sin bodega</span>
            }
        </div>
        @if (Model.Detalles.Any())
        {
            <div class="fs-6 mt-1">
                <strong>Tiempo estándar:</strong> @PickingApp.Services.Formato.Duracion(tiempoEstandar)
                <span class="text-secondary small">(según la categoría de cada producto)</span>
            </div>
            @if (Model.Empleado != null && Model.TiempoEstimadoMinutos.HasValue)
            {
                <div class="fs-6 mt-1">
                    <strong>Tiempo estimado:</strong> @PickingApp.Services.Formato.Duracion(Model.TiempoEstimadoMinutos.Value)
                    <span class="text-secondary small">(según el rendimiento de @Model.Empleado.NombreCompleto al asignarlo)</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.MotivoReasignacion))
            {
                <div class="fs-6 mt-1">
                    <strong>Motivo de reasignación:</strong> @Model.MotivoReasignacion
                </div>
            }
            @if (Model.Estado == "Completado" && Model.TiempoProcesamientoMinutos.HasValue)
            {
                <div class="fs-6 mt-1">
                    <strong>Tiempo real:</strong> @PickingApp.Services.Formato.Duracion(Model.TiempoProcesamientoMinutos.Value)
                </div>
            }
            @if (superaJornada && Model.Estado == "Pendiente")
            {
                <div class="pf-aviso-jornada mt-2" role="note">
                    <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                    A ritmo estándar, este pedido supera una jornada completa (@maxHorasJornada.ToString("0.#") h).
                    @if (esGestor && puedeDividir)
                    {
                        <a asp-action="Dividir" asp-route-id="@Model.Id" class="fw-semibold">Dividirlo en @partesSugeridas partes</a>
                    }
                </div>
            }
        }
    </div>

    @if (partes.Any())
    {
        <!-- Partes del pedido dividido -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                <h5 class="fw-bold mb-0 text-dark">Partes</h5>
                <span class="text-muted fw-semibold small">@partesTerminadas de @partes.Count partes finalizadas</span>
            </div>
            <div class="pf-progreso-partes mb-3" role="img" aria-label="@partesTerminadas de @partes.Count partes finalizadas">
                <span style="width: @((partes.Count == 0 ? 0 : partesTerminadas * 100 / partes.Count))%"></span>
            </div>
            <div class="table-responsive">
                <table class="mockup-table">
                    <thead>
                        <tr>
                            <th>Parte</th>
                            <th>Estado</th>
                            <th>Empleado</th>
                            <th class="text-end">Unidades</th>
                            <th class="text-end">Tiempo estándar</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pa in partes)
                        {
                            <tr>
                                <td class="fw-semibold">@pa.CodigoPedido</td>
                                <td>@pa.Estado</td>
                                <td>@(pa.Empleado?.NombreCompleto ?? "Sin asignar")</td>
                                <td class="text-end">@pa.Detalles.Sum(d => d.Cantidad)</td>
                                <td class="text-end">@PickingApp.Services.Formato.Duracion(pa.TiempoEstandarMinutos ?? tiemposPartes.GetValueOrDefault(pa.Id))</td>
                                <td class="text-center">
                                    <a asp-action="Detalle" asp-route-id="@pa.Id" class="btn-pf-blue" style="padding: 4px 20px; font-size: 14px;">Ver</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Productos section -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h5 class="fw-bold mb-0 text-dark">@(esDividido || partes.Any() ? "Productos del pedido original" : "Productos")</h5>
            @if (Model.Detalles.Count > 1)
            {
                <div class="d-flex gap-2 flex-wrap align-items-center">
                    <input type="text" id="filtroProductoTexto" class="mockup-search-input" placeholder="Buscar producto, código o ubicación..." />
                    @if (pasillosPedido.Count > 1)
                    {
                        <select id="filtroProductoPasillo" class="form-select form-select-sm" style="width: auto;">
                            <option value="">Todos los pasillos</option>
                            @foreach (var pas in pasillosPedido)
                            {
                                <option value="@pas">Pasillo @pas</option>
                            }
                        </select>
                    }
                </div>
            }
        </div>
        <div class="table-responsive">
            <table class="mockup-table" id="tablaProductosPedido">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Cantidad</th>
                        <th>Ubicación</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Detalles.Any())
                    {
                        var indice = 0;
                        @foreach (var d in Model.Detalles)
                        {
                            <tr class="fila-producto @(indice++ >= productosVisibles ? "fila-extra d-none" : "")"
                                data-buscar="@($"{d.NombreProducto} {d.CodigoProducto} {d.Ubicacion?.CodigoUbicacion}".ToLowerInvariant())"
                                data-pasillo="@(d.Ubicacion?.Pasillo)">
                                <td class="fw-semibold">@d.NombreProducto</td>
                                <td>
                                    @if (d.Ubicacion?.Producto?.Categoria != null)
                                    {
                                        @d.Ubicacion.Producto.Categoria.Nombre
                                    }
                                    else
                                    {
                                        <span style="color: #4B5563;">@categoriaPredeterminada <span class="small">(por defecto)</span></span>
                                    }
                                </td>
                                <td>@d.Cantidad</td>
                                <td>
                                    @if (d.Ubicacion != null)
                                    {
                                        @d.Ubicacion.CodigoUbicacion
                                    }
                                    else
                                    {
                                        @* Nunca se inventa una ubicación: se indica que falta *@
                                        <span class="fst-italic" style="color: #4B5563;">Sin ubicación</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">No hay productos registrados en este pedido</td>
                        </tr>
                    }
                    <tr id="filaSinCoincidencias" class="d-none">
                        <td colspan="4" class="text-center text-muted py-3">Ningún producto coincide con el filtro</td>
                    </tr>
                </tbody>
            </table>
        </div>
        @if (productosOcultos > 0)
        {
            <div class="text-center mt-2" id="contenedorVerMasProductos">
                <button type="button" id="btnVerMasProductos" class="btn btn-link fw-semibold text-decoration-none"
                        data-ver-mas="tablaProductosPedido"
                        data-texto-mas="Ver más (@productosOcultos productos)" data-texto-menos="Ver menos">
                    Ver más (@productosOcultos productos)
                </button>
            </div>
        }
    </div>

    <!-- Novedades registradas (CU-29 / CU-30) -->
    @if (Model.Novedades != null && Model.Novedades.Any())
    {
        <div class="mb-4">
            <h5 class="fw-bold mb-3 text-dark">Novedades registradas</h5>
            <div class="table-responsive">
                <table class="mockup-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Descripción</th>
                            <th>Registrado por</th>
                            <th>Estado</th>
                            @if (userRole == "Administrador")
                            {
                                <th class="text-center">Acción</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var nov in Model.Novedades.OrderByDescending(n => n.FechaRegistro))
                        {
                            <tr>
                                <td>@nov.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@nov.TipoNovedad</td>
                                <td>@nov.Descripcion</td>
                                <td>@nov.RegistradoPor</td>
                                <td>
                                    @if (nov.Atendida)
                                    {
                                        <span class="badge bg-success">Atendida</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                </td>
                                @if (userRole == "Administrador")
                                {
                                    <td class="text-center">
                                        @if (!nov.Atendida)
                                        {
                                            <button type="button" class="btn-pf-gray" style="padding: 4px 16px; font-size: 14px;"
                                                    data-bs-toggle="modal" data-bs-target="#modalAtenderNovedad"
                                                    onclick="document.getElementById('atenderNovedadId').value='@nov.Id';">
                                                Atender
                                            </button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Action Buttons matching Slide 7 -->
    <div class="d-flex flex-wrap gap-3 mt-4 pt-2 align-items-center">
        @if (userRole == "Administrador" || userRole == "Supervisor")
        {
            @if (Model.Estado == "Pendiente")
            {
                <a asp-action="Asignar" asp-route-id="@Model.Id" class="btn-pf-blue">
                    Asignar Empleado
                </a>
                @if (puedeDividir)
                {
                    <a asp-action="Dividir" asp-route-id="@Model.Id" class="btn-pf-gray">
                        <i class="bi bi-diagram-3 me-1" aria-hidden="true"></i> Dividir pedido
                    </a>
                }
            }
            else if (puedeDeshacerDivision)
            {
                <form asp-action="DeshacerDivision" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pedidoId" value="@Model.Id" />
                    <button type="submit" class="btn-pf-gray">
                        <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i> Deshacer división
                    </button>
                </form>
            }
            else if (Model.EstaEnCurso)
            {
                <button type="button" class="btn-pf-blue" style="background-color: #52A447;" data-bs-toggle="modal" data-bs-target="#modalCompletar">
                    Marcar Completado
                </button>
                <a asp-action="Asignar" asp-route-id="@Model.Id" class="btn-pf-blue" style="background-color: #F59E0B;">
                    Reasignar
                </a>
            }

            @if (!Model.EstaFinalizado)
            {
                <button type="button" class="btn-pf-blue" data-bs-toggle="modal" data-bs-target="#modalCancelar">
                    Cancelar pedido
                </button>
            }

            <button type="button" class="btn-pf-gray" data-bs-toggle="modal" data-bs-target="#modalNovedad">
                Novedad
            </button>
        }

        <a asp-action="Index" class="btn-pf-gray">
            Volver a pedidos
        </a>
    </div>
</div>

@if (userRole == "Administrador")
{
    <!-- Modal Cambiar Prioridad (CU-25) -->
    <div class="modal fade" id="modalPrioridad" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 border-0 p-2">
                <form asp-action="CambiarPrioridad" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pedidoId" value="@Model.Id" />
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold text-dark">Cambiar prioridad</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label fw-bold">Nueva prioridad:</label>
                        <select name="nuevaPrioridad" class="form-select">
                            <option value="Alta" selected="@(Model.Prioridad == "Alta")">Alta</option>
                            <option value="Media" selected="@(Model.Prioridad == "Media")">Media</option>
                            <option value="Baja" selected="@(Model.Prioridad == "Baja")">Baja</option>
                        </select>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-pf-blue">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Atender Novedad (CU-30) -->
    <div class="modal fade" id="modalAtenderNovedad" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 border-0 p-2">
                <form asp-action="AtenderNovedad" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="atenderNovedadId" name="novedadId" value="" />
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold text-dark">Atender novedad</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label fw-bold">Observaciones de atención:</label>
                        <textarea name="observacionesAtencion" class="form-control" rows="3" placeholder="Describa cómo fue atendida la novedad"></textarea>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-pf-blue">Marcar como atendida</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal Cancelar (CU-31) -->
<div class="modal fade" id="modalCancelar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 p-2">
            <form asp-action="Cancelar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@Model.Id" />
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-danger">Cancelar Pedido</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mockup-alert-warning mt-0 mb-3">
                        <strong>Atención:</strong> Un pedido cancelado no podrá reactivarse.
                        @if (esDividido)
                        {
                            <div class="mt-1">También se cancelarán las partes que no hayan terminado; las completadas se conservan.</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Motivo de Cancelación (Obligatorio):</label>
                        <textarea name="motivoCancelacion" class="form-control" rows="3" required placeholder="Especifique el motivo de cancelación"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn-pf-blue" style="background-color: #DC2626;">Confirmar Cancelación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Completar (CU-28) -->
<div class="modal fade" id="modalCompletar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 p-2">
            <form asp-action="MarcarCompletado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@Model.Id" />
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-success">Finalizar Pedido de Picking</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>¿Desea marcar como completado el pedido <strong>@Model.CodigoPedido</strong>?</p>
                    <div class="form-check p-3 bg-light rounded-3 mb-2">
                        <input class="form-check-input" type="checkbox" name="confirmacionFisica" id="chkFisica" value="true" required />
                        <label class="form-check-label fw-semibold text-dark" for="chkFisica">
                            Confirmo que el empleado ha entregado físicamente la mercancía completa.
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-pf-blue" style="background-color: #52A447;">Marcar como Completado</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Registrar Novedad (CU-29) -->
<div class="modal fade" id="modalNovedad" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 p-2">
            <form asp-action="RegistrarNovedad" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@Model.Id" />
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-warning">Registrar Novedad</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tipo de Novedad:</label>
                        <select name="tipoNovedad" class="form-select">
                            <option value="Faltante">Faltante de Producto</option>
                            <option value="Avería">Avería / Producto Dañado</option>
                            <option value="Ubicación Incorrecta">Ubicación Física Incorrecta</option>
                            <option value="Diferencia Cantidad">Diferencia de Cantidades</option>
                            <option value="Otro">Otro Motivo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Descripción de la Novedad:</label>
                        <textarea name="descripcion" class="form-control" rows="3" required placeholder="Detalle la situación encontrada"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-pf-blue">Registrar Novedad</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Con un filtro activo se muestran todas las coincidencias (sin el límite de 5);
        // al limpiarlo se recupera el estado de "Ver más / Ver menos".
        (function () {
            var texto = document.getElementById('filtroProductoTexto');
            var pasillo = document.getElementById('filtroProductoPasillo');
            if (!texto) return;
            var filas = document.querySelectorAll('#tablaProductosPedido .fila-producto');
            var sinCoincidencias = document.getElementById('filaSinCoincidencias');
            var contenedorVerMas = document.getElementById('contenedorVerMasProductos');
            var btnVerMas = document.getElementById('btnVerMasProductos');

            function aplicar() {
                var t = texto.value.trim().toLowerCase();
                var pas = pasillo ? pasillo.value : '';
                var activo = t !== '' || pas !== '';
                var expandido = btnVerMas && btnVerMas.dataset.expandido === 'true';
                var visibles = 0;

                filas.forEach(function (f) {
                    var mostrar = activo
                        ? f.dataset.buscar.indexOf(t) !== -1 && (pas === '' || f.dataset.pasillo === pas)
                        : !f.classList.contains('fila-extra') || expandido;
                    f.classList.toggle('d-none', !mostrar);
                    if (mostrar) visibles++;
                });

                sinCoincidencias.classList.toggle('d-none', !(activo && visibles === 0));
                if (contenedorVerMas) contenedorVerMas.classList.toggle('d-none', activo);
            }

            texto.addEventListener('input', aplicar);
            if (pasillo) pasillo.addEventListener('change', aplicar);
        })();
    </script>
}
