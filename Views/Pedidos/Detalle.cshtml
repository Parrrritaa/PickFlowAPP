@model PickingApp.Models.ViewModels.PedidoDetalleViewModel
@{
    var pedido = Model.Pedido;
    ViewData["Title"] = $"Pedido {pedido.CodigoPedido}";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? Roles.Auxiliar;
    var totalUbicaciones = pedido.Detalles.Select(d => d.UbicacionId).Distinct().Count();
    var tiempoEstandar = Model.TiempoEstandar;
    var maxHorasJornada = Model.MaxHorasJornada;
    var categoriaPredeterminada = Model.CategoriaPredeterminada;
    var superaJornada = tiempoEstandar > maxHorasJornada * 60;
    var partesSugeridas = pedido.PartesSugeridas(tiempoEstandar, maxHorasJornada * 60);
    var esDividido = pedido.EstaDividido;
    var partes = pedido.Partes.OrderBy(pa => pa.NumeroParte).ToList();
    var tiemposPartes = Model.TiemposPartes;
    var partesTerminadas = partes.Count(pa => pa.EstaFinalizado);
    var puedeDividir = pedido.MotivoNoDivisible() == null;
    var puedeDeshacerDivision = pedido.PuedeDeshacerDivision;
    var esGestor = userRole == Roles.Administrador || userRole == Roles.Supervisor;
    if (totalUbicaciones == 0) totalUbicaciones = pedido.Detalles.Count;
    var pasillosPedido = pedido.Detalles
        .Where(d => d.Ubicacion != null)
        .Select(d => d.Ubicacion!.Pasillo)
        .Distinct()
        .OrderBy(x => int.TryParse(x, out var n) ? n : int.MaxValue)
        .ToList();

    var unidades = pedido.Detalles.Sum(d => d.Cantidad);

    // Barra de tiempo: el real si ya terminó, el estimado si está en curso; sin ninguno (pendiente) solo se muestra el texto.
    // La escala deja un 15 % de aire sobre el mayor valor para que la marca del estándar no quede pegada al borde.
    double? valorTiempo = pedido.Estado == PedidoEstados.Completado && pedido.TiempoProcesamientoMinutos.HasValue
        ? pedido.TiempoProcesamientoMinutos
        : pedido.EstaEnCurso ? pedido.TiempoEstimadoMinutos : null;
    var etiquetaTiempo = pedido.Estado == PedidoEstados.Completado ? "Real" : "Estimado";
    var escalaTiempo = Math.Max(tiempoEstandar, valorTiempo ?? 0) * 1.15;
    string PorcentajeEscala(double minutos) => escalaTiempo <= 0 ? "0" : (100 * minutos / escalaTiempo).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    // Punto de color del estado y color de la prioridad: los mismos de la lista de pedidos
    string ClaseEstado(string estado) => estado switch
    {
        PedidoEstados.Pendiente => "is-pendiente",
        PedidoEstados.Asignado => "is-asignado",
        PedidoEstados.Reasignado => "is-reasignado",
        PedidoEstados.Completado => "is-completado",
        PedidoEstados.Cancelado => "is-cancelado",
        _ => "is-dividido"
    };
    string ClasePrioridad(string prioridad) => prioridad switch { "Alta" => "is-alta", "Baja" => "is-baja", _ => "is-media" };

    // Qué toca hacer ahora, en una frase, encima de las acciones del panel
    string SiguientePaso() => pedido.Estado switch
    {
        PedidoEstados.Pendiente => superaJornada && puedeDividir
            ? "Supera una jornada: divídelo o asígnalo a un empleado."
            : "Asígnalo a un empleado disponible.",
        PedidoEstados.Dividido => puedeDeshacerDivision
            ? "Ninguna parte está asignada: aún se puede deshacer la división."
            : "Cada parte se asigna y completa por separado.",
        PedidoEstados.Completado => "Pedido entregado. Si algo no cuadró, registra una novedad.",
        PedidoEstados.Cancelado => "Pedido cancelado.",
        _ => "Cuando el empleado termine, márcalo como completado."
    };
}

<h1 class="pf-page-title">Pedido @pedido.CodigoPedido</h1>

@if (pedido.PedidoPadre != null)
{
    <div class="pf-banner-parte mb-3">
        <i class="bi bi-diagram-3" aria-hidden="true"></i>
        <span>
            Parte @pedido.NumeroParte de @pedido.PedidoPadre.Partes.Count del pedido
            <a asp-action="Detalle" asp-route-id="@pedido.PedidoPadreId">@pedido.PedidoPadre.CodigoPedido</a>
        </span>
    </div>
}

@* Ficha a la izquierda (qué es el pedido y qué lleva) y panel fijo a la derecha (quién, prioridad y qué se puede hacer
   ahora), igual que Revisar solicitud: las acciones quedan a la vista sin bajar hasta el final de la página. *@
<div class="pf-sol pf-sol--con-panel">
    <article class="pf-card pf-sol-principal mb-0" aria-label="Pedido @pedido.CodigoPedido">
        <header class="pf-ped-cabecera">
            <span class="pf-estado-punto @ClaseEstado(pedido.Estado)">@(esDividido ? "En curso (dividido)" : pedido.Estado)</span>
            <ul class="pf-ped-meta">
                <li>
                    <i class="bi bi-building" aria-hidden="true"></i>
                    @if (pedido.Bodega != null)
                    {
                        @pedido.Bodega.Nombre <span class="pf-ped-tenue">@pedido.Bodega.Codigo</span>
                    }
                    else
                    {
                        <span class="pf-ped-tenue">Sin bodega</span>
                    }
                </li>
                <li><i class="bi bi-geo-alt" aria-hidden="true"></i>@totalUbicaciones @(totalUbicaciones == 1 ? "ubicación" : "ubicaciones")</li>
                <li><i class="bi bi-box-seam" aria-hidden="true"></i>@unidades @(unidades == 1 ? "unidad" : "unidades")</li>
                <li><i class="bi bi-clock" aria-hidden="true"></i>Cargado <time datetime="@pedido.FechaCarga.ToString("s")">@pedido.FechaCarga.ToString("dd/MM/yyyy HH:mm")</time></li>
            </ul>
        </header>

        @if (pedido.Detalles.Any())
        {
            <section class="pf-sol-seccion" aria-labelledby="tituloTiempo">
                <h3 class="pf-sol-subtitulo" id="tituloTiempo">Tiempo</h3>
                @if (valorTiempo.HasValue)
                {
                    @* La barra es el tiempo real (o el estimado si aún no termina); la marca vertical es el estándar *@
                    <div class="pf-tiempo" role="img" aria-label="@etiquetaTiempo @PickingApp.Services.Formato.Duracion(valorTiempo.Value) de @PickingApp.Services.Formato.Duracion(tiempoEstandar) estándar">
                        <span class="pf-tiempo__valor @(valorTiempo <= tiempoEstandar ? "is-dentro" : "is-fuera")" style="width: @(PorcentajeEscala(valorTiempo.Value))%"></span>
                        <span class="pf-tiempo__estandar" style="left: @(PorcentajeEscala(tiempoEstandar))%"></span>
                    </div>
                }
                <p class="pf-tiempo__leyenda">
                    @if (pedido.Estado == PedidoEstados.Completado && pedido.TiempoProcesamientoMinutos.HasValue)
                    {
                        <span><b>Real @PickingApp.Services.Formato.Duracion(pedido.TiempoProcesamientoMinutos.Value)</b></span>
                    }
                    <span>Estándar @PickingApp.Services.Formato.Duracion(tiempoEstandar)</span>
                    @if (pedido.Empleado != null && pedido.TiempoEstimadoMinutos.HasValue)
                    {
                        var estimado = $"Estimado {PickingApp.Services.Formato.Duracion(pedido.TiempoEstimadoMinutos.Value)}";
                        <span title="Según el rendimiento de @pedido.Empleado.NombreCompleto al asignarlo">
                            @if (pedido.EstaEnCurso)
                            {
                                <b>@estimado</b>
                            }
                            else
                            {
                                @estimado
                            }
                        </span>
                    }
                </p>
                @if (!string.IsNullOrEmpty(pedido.MotivoReasignacion))
                {
                    <p class="pf-ped-nota"><i class="bi bi-arrow-left-right" aria-hidden="true"></i>Reasignado: @pedido.MotivoReasignacion</p>
                }
                @if (!string.IsNullOrEmpty(pedido.MotivoCancelacion))
                {
                    <p class="pf-ped-nota"><i class="bi bi-x-circle" aria-hidden="true"></i>Cancelado: @pedido.MotivoCancelacion</p>
                }
                @if (superaJornada && pedido.Estado == PedidoEstados.Pendiente)
                {
                    <div class="pf-aviso-jornada mt-2" role="note">
                        <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                        A ritmo estándar, este pedido supera una jornada completa (@maxHorasJornada.ToString("0.#") h).
                        @if (esGestor && puedeDividir)
                        {
                            <a asp-action="Dividir" asp-route-id="@pedido.Id" class="fw-semibold">Dividirlo en @partesSugeridas partes</a>
                        }
                    </div>
                }
            </section>
        }

        @if (partes.Any())
        {
            <section class="pf-sol-seccion" aria-labelledby="tituloPartes">
                <div class="pf-ped-seccion-cabecera">
                    <h3 class="pf-sol-subtitulo" id="tituloPartes">Partes</h3>
                    <span class="pf-ped-tenue small">@partesTerminadas de @partes.Count finalizadas</span>
                </div>
                <div class="pf-progreso-partes mb-2" role="img" aria-label="@partesTerminadas de @partes.Count partes finalizadas">
                    <span style="width: @((partes.Count == 0 ? 0 : partesTerminadas * 100 / partes.Count))%"></span>
                </div>
                <div class="table-responsive">
                    <table class="pf-table">
                        <thead>
                            <tr>
                                <th>Parte</th>
                                <th>Estado</th>
                                <th>Empleado</th>
                                <th class="text-end">Unidades</th>
                                <th class="text-end">Tiempo estándar</th>
                                <th class="text-end"><span class="visually-hidden">Abrir</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pa in partes)
                            {
                                <tr>
                                    <td class="fw-semibold">@pa.CodigoPedido</td>
                                    <td><span class="pf-estado-punto @ClaseEstado(pa.Estado)">@pa.Estado</span></td>
                                    <td>@(pa.Empleado?.NombreCompleto ?? "Sin asignar")</td>
                                    <td class="text-end">@pa.Detalles.Sum(d => d.Cantidad)</td>
                                    <td class="text-end">@PickingApp.Services.Formato.Duracion(pa.TiempoEstandarMinutos ?? tiemposPartes.GetValueOrDefault(pa.Id))</td>
                                    <td class="text-end">
                                        <a asp-action="Detalle" asp-route-id="@pa.Id" class="pf-btn-abrir" data-fila-abre aria-label="Abrir @pa.CodigoPedido" title="Abrir">
                                            <partial name="_Icono" model='"derecha"' />
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <section class="pf-sol-seccion" aria-labelledby="tituloProductos">
            <div class="pf-ped-seccion-cabecera">
                <h3 class="pf-sol-subtitulo" id="tituloProductos">@(esDividido || partes.Any() ? "Productos del pedido original" : "Productos")</h3>
                @if (pedido.Detalles.Count > 1)
                {
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <label class="visually-hidden" for="filtroProductoTexto">Buscar producto</label>
                        <input type="search" id="filtroProductoTexto" class="pf-search-input" placeholder="Buscar producto o ubicación" autocomplete="off" />
                        @if (pasillosPedido.Count > 1)
                        {
                            <label class="visually-hidden" for="filtroProductoPasillo">Pasillo</label>
                            <select id="filtroProductoPasillo" class="form-select form-select-sm" style="width: auto;">
                                <option value="">Todos los pasillos</option>
                                @foreach (var pas in pasillosPedido)
                                {
                                    <option value="@pas">Pasillo @pas</option>
                                }
                            </select>
                        }
                    </div>
                }
            </div>
            <div class="table-responsive">
                <table class="pf-table" id="tablaProductosPedido" data-pf-paginar>
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th class="text-end">Cantidad</th>
                            <th>Ubicación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pedido.Detalles.Any())
                        {
                            @foreach (var d in pedido.Detalles)
                            {
                                <tr class="fila-producto"
                                    data-buscar="@($"{d.NombreProducto} {d.CodigoProducto} {d.Ubicacion?.CodigoUbicacion}".ToLowerInvariant())"
                                    data-pasillo="@(d.Ubicacion?.Pasillo)">
                                    <td>
                                        <div class="fw-semibold">@d.NombreProducto</div>
                                        <div class="pf-ped-tenue small">@d.CodigoProducto</div>
                                    </td>
                                    <td>
                                        @if (d.Ubicacion?.Producto?.Categoria != null)
                                        {
                                            @d.Ubicacion.Producto.Categoria.Nombre
                                        }
                                        else
                                        {
                                            <span class="pf-ped-tenue">@categoriaPredeterminada <span class="small">(por defecto)</span></span>
                                        }
                                    </td>
                                    <td class="text-end pf-num">@d.Cantidad</td>
                                    <td class="pf-num">
                                        @if (d.Ubicacion != null)
                                        {
                                            @d.Ubicacion.CodigoUbicacion
                                        }
                                        else
                                        {
                                            @* Nunca se inventa una ubicación: se indica que falta *@
                                            <span class="fst-italic pf-ped-tenue">Sin ubicación</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">Este pedido no tiene productos registrados.</td>
                            </tr>
                        }
                        <tr id="filaSinCoincidencias" class="d-none">
                            <td colspan="4" class="text-center text-muted py-3">Ningún producto coincide con el filtro.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Novedades registradas (CU-29 / CU-30) -->
        @if (pedido.Novedades != null && pedido.Novedades.Any())
        {
            <section class="pf-sol-seccion" id="novedades" aria-labelledby="tituloNovedades">
                <h3 class="pf-sol-subtitulo" id="tituloNovedades">Novedades</h3>
                <div class="table-responsive">
                    <table class="pf-table">
                        <thead>
                            <tr>
                                @* Tres columnas y no cinco: junto al panel de acciones la columna es angosta y la tabla se recortaba *@
                                <th>Novedad</th>
                                <th>Registro</th>
                                <th>Estado</th>
                                @if (userRole == Roles.Administrador)
                                {
                                    <th class="text-end"><span class="visually-hidden">Acción</span></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var nov in pedido.Novedades.OrderByDescending(n => n.FechaRegistro))
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@nov.TipoNovedad</div>
                                        @nov.Descripcion
                                    </td>
                                    <td>
                                        <span class="pf-num text-nowrap">@nov.FechaRegistro.ToString("dd/MM/yyyy")</span>
                                        <div class="text-secondary small">@nov.FechaRegistro.ToString("HH:mm") · @nov.RegistradoPor</div>
                                    </td>
                                    <td>
                                        <span class="pf-marca-novedad @(nov.Atendida ? "is-atendida" : "is-pendiente")">
                                            <i class="bi @(nov.Atendida ? "bi-check2" : "bi-exclamation-triangle-fill")" aria-hidden="true"></i>@(nov.Atendida ? "Atendida" : "Sin atender")
                                        </span>
                                    </td>
                                    @if (userRole == Roles.Administrador)
                                    {
                                        <td class="text-end">
                                            @if (!nov.Atendida)
                                            {
                                                <button type="button" class="btn-pf-gray pf-btn-fila"
                                                        data-bs-toggle="modal" data-bs-target="#modalAtenderNovedad"
                                                        onclick="document.getElementById('atenderNovedadId').value='@nov.Id';">
                                                    Atender
                                                </button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </article>

    <aside class="pf-card pf-sol-panel pf-ped-panel mb-0" aria-label="Acciones del pedido">
        <dl class="pf-datos pf-datos--una">
            <div>
                <dt>Prioridad</dt>
                <dd class="pf-ped-prioridad">
                    <span class="pf-prioridad @ClasePrioridad(pedido.Prioridad)">@pedido.Prioridad</span>
                    @if (userRole == Roles.Administrador)
                    {
                        <button type="button" class="pf-link-btn" data-bs-toggle="modal" data-bs-target="#modalPrioridad">Cambiar</button>
                    }
                </dd>
            </div>
            <div>
                <dt>Responsable</dt>
                <dd>@(esDividido || partes.Any() ? "Por partes" : pedido.Empleado?.NombreCompleto ?? "Sin asignar")</dd>
            </div>
        </dl>

        @if (esGestor)
        {
            @* Una sola acción principal según el estado; las demás debajo, y cancelar aparte para no pulsarla por error *@
            <p class="pf-ped-siguiente">@SiguientePaso()</p>
            <div class="d-grid gap-2">
                @if (pedido.Estado == PedidoEstados.Pendiente)
                {
                    <a asp-action="Asignar" asp-route-id="@pedido.Id" class="btn-pf-blue text-center">Asignar empleado</a>
                    @if (puedeDividir)
                    {
                        <a asp-action="Dividir" asp-route-id="@pedido.Id" class="btn-pf-gray text-center">
                            <i class="bi bi-diagram-3 me-1" aria-hidden="true"></i>Dividir pedido
                        </a>
                    }
                }
                else if (puedeDeshacerDivision)
                {
                    <form asp-action="DeshacerDivision" method="post" class="d-grid">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="pedidoId" value="@pedido.Id" />
                        <button type="submit" class="btn-pf-gray">
                            <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Deshacer división
                        </button>
                    </form>
                }
                else if (pedido.EstaEnCurso)
                {
                    <button type="button" class="btn-pf-green" data-bs-toggle="modal" data-bs-target="#modalCompletar">Marcar completado</button>
                    <a asp-action="Asignar" asp-route-id="@pedido.Id" class="btn-pf-gray text-center">Reasignar</a>
                }

                <button type="button" class="btn-pf-gray" data-bs-toggle="modal" data-bs-target="#modalNovedad">
                    <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>Registrar novedad
                </button>
            </div>
        }

        <div class="pf-ped-panel-pie">
            <a asp-action="Index" class="btn-pf-gray pf-ped-pie-btn">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>Volver
            </a>
            @if (esGestor && !pedido.EstaFinalizado)
            {
                <button type="button" class="btn-pf-gray pf-ped-pie-btn pf-ped-cancelar" data-bs-toggle="modal" data-bs-target="#modalCancelar">
                    <i class="bi bi-x-circle" aria-hidden="true"></i>Cancelar pedido
                </button>
            }
        </div>
    </aside>
</div>

@if (userRole == Roles.Administrador)
{
    <!-- Modal Cambiar Prioridad (CU-25) -->
    <div class="modal fade" id="modalPrioridad" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 border-0 p-2">
                <form asp-action="CambiarPrioridad" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pedidoId" value="@pedido.Id" />
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold text-dark">Cambiar prioridad</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label fw-bold">Nueva prioridad:</label>
                        <select name="nuevaPrioridad" class="form-select">
                            @foreach (var prioridad in Prioridades.Todas)
                            {
                                <option value="@prioridad" selected="@(pedido.Prioridad == prioridad)">@prioridad</option>
                            }
                        </select>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-pf-blue">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Atender Novedad (CU-30) -->
    <div class="modal fade" id="modalAtenderNovedad" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 border-0 p-2">
                <form asp-action="AtenderNovedad" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="atenderNovedadId" name="novedadId" value="" />
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold text-dark">Atender novedad</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label fw-bold">Observaciones de atención:</label>
                        <textarea name="observacionesAtencion" class="form-control" rows="3" maxlength="500" placeholder="Describa cómo fue atendida la novedad"></textarea>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-pf-blue">Marcar como atendida</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal Cancelar (CU-31) -->
<div class="modal fade" id="modalCancelar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 p-2">
            <form asp-action="Cancelar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@pedido.Id" />
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-danger">Cancelar Pedido</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="pf-alert-warning mt-0 mb-3">
                        <strong>Atención:</strong> Un pedido cancelado no podrá reactivarse.
                        @if (esDividido)
                        {
                            <div class="mt-1">También se cancelarán las partes que no hayan terminado; las completadas se conservan.</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Motivo de Cancelación (Obligatorio):</label>
                        <textarea name="motivoCancelacion" class="form-control" rows="3" maxlength="250" required placeholder="Especifique el motivo de cancelación"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn-pf-red">Confirmar Cancelación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Completar (CU-28) -->
<div class="modal fade" id="modalCompletar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 p-2">
            <form asp-action="MarcarCompletado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@pedido.Id" />
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-success">Finalizar Pedido de Picking</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>¿Desea marcar como completado el pedido <strong>@pedido.CodigoPedido</strong>?</p>
                    <div class="form-check p-3 bg-light rounded-3 mb-2">
                        <input class="form-check-input" type="checkbox" name="confirmacionFisica" id="chkFisica" value="true" required />
                        <label class="form-check-label fw-semibold text-dark" for="chkFisica">
                            Confirmo que el empleado ha entregado físicamente la mercancía completa.
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-pf-green">Marcar como Completado</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Registrar Novedad (CU-29) -->
<div class="modal fade" id="modalNovedad" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 p-2">
            <form asp-action="RegistrarNovedad" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@pedido.Id" />
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-warning">Registrar Novedad</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tipo de Novedad:</label>
                        <select name="tipoNovedad" class="form-select">
                            <option value="@TiposNovedad.Faltante">Faltante de Producto</option>
                            <option value="@TiposNovedad.Averia">Avería / Producto Dañado</option>
                            <option value="@TiposNovedad.UbicacionIncorrecta">Ubicación Física Incorrecta</option>
                            <option value="@TiposNovedad.DiferenciaCantidad">Diferencia de Cantidades</option>
                            <option value="@TiposNovedad.Otro">Otro Motivo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Descripción de la Novedad:</label>
                        <textarea name="descripcion" class="form-control" rows="3" maxlength="500" required placeholder="Detalle la situación encontrada"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-pf-blue">Registrar Novedad</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Oculta los productos que no coinciden y vuelve a la primera página de la tabla (paginación de site.js)
        (function () {
            var texto = document.getElementById('filtroProductoTexto');
            var pasillo = document.getElementById('filtroProductoPasillo');
            if (!texto) return;
            var tabla = document.getElementById('tablaProductosPedido');
            var filas = tabla.querySelectorAll('.fila-producto');
            var sinCoincidencias = document.getElementById('filaSinCoincidencias');

            function aplicar() {
                var t = texto.value.trim().toLowerCase();
                var pas = pasillo ? pasillo.value : '';
                var visibles = 0;

                filas.forEach(function (f) {
                    var mostrar = f.dataset.buscar.indexOf(t) !== -1 && (pas === '' || f.dataset.pasillo === pas);
                    f.classList.toggle('d-none', !mostrar);
                    if (mostrar) visibles++;
                });

                sinCoincidencias.classList.toggle('d-none', visibles > 0);
                tabla.dispatchEvent(new CustomEvent('pf:repaginar', { detail: { inicio: true } }));
            }

            texto.addEventListener('input', aplicar);
            if (pasillo) pasillo.addEventListener('change', aplicar);
        })();
    </script>
}
