@model List<PickingApp.Models.Producto>
@using PickingApp.Services
@{
    ViewData["Title"] = "Productos y categorías";
    var categorias = ViewBag.Categorias as List<PickingApp.Models.CategoriaProducto> ?? new List<PickingApp.Models.CategoriaProducto>();
    var minutosPorUbicacion = ViewBag.MinutosPorUbicacion as double? ?? 1.0;
    var predeterminada = categorias.FirstOrDefault(c => c.EsPredeterminada);
    var nombrePredeterminada = predeterminada?.Nombre ?? "la categoría por defecto";
    var sinClasificar = Model.Count(p => p.CategoriaProductoId == null);
}

<h1 class="pf-page-title">Productos y categorías</h1>

<!-- ===== Categorías de manipulación ===== -->
<div class="mockup-card">
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
        <div>
            <h4 class="fw-bold mb-1 text-dark">Categorías de manipulación</h4>
            <p class="pf-seccion-desc">
                Cuánto se tarda en recoger una unidad. El tiempo estándar de un pedido suma, por cada producto,
                sus unidades × los minutos de su categoría, más @Formato.Duracion(minutosPorUbicacion) de recorrido por ubicación
                (<a asp-controller="Auditoria" asp-action="Configuracion">ajustable en Configuración</a>).
            </p>
        </div>
        <button type="button" class="btn-pf-blue" data-bs-toggle="modal" data-bs-target="#modalCategoria" data-modo="crear">
            + Nueva categoría
        </button>
    </div>

    <div class="table-responsive">
        <table class="mockup-table">
            <thead>
                <tr>
                    <th>Categoría</th>
                    <th>Minutos por unidad</th>
                    <th>Productos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in categorias)
                {
                    <tr>
                        <td>
                            <span class="fw-semibold">@c.Nombre</span>
                            @if (c.EsPredeterminada)
                            {
                                <span class="pf-badge-defecto">Por defecto</span>
                            }
                            @if (!string.IsNullOrEmpty(c.Descripcion))
                            {
                                <div class="small" style="color: #4B5563;">@c.Descripcion</div>
                            }
                        </td>
                        <td>@c.MinutosPorUnidad.ToString("0.##") min</td>
                        <td>
                            @c.Productos.Count
                            @if (c.EsPredeterminada && sinClasificar > 0)
                            {
                                <span class="small" style="color: #4B5563;">+ @sinClasificar sin clasificar</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex justify-content-end gap-2 flex-wrap">
                                <button type="button" class="btn-pf-gray" style="padding: 4px 14px; font-size: 14px;"
                                        data-bs-toggle="modal" data-bs-target="#modalCategoria" data-modo="editar"
                                        data-id="@c.Id" data-nombre="@c.Nombre" data-minutos="@Formato.ParaInput(c.MinutosPorUnidad)" data-descripcion="@c.Descripcion">
                                    Editar
                                </button>
                                @if (!c.EsPredeterminada)
                                {
                                    <form asp-action="HacerPredeterminada" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn-pf-gray" style="padding: 4px 14px; font-size: 14px;">Usar por defecto</button>
                                    </form>
                                    <button type="button" class="btn-pf-gray" style="padding: 4px 14px; font-size: 14px;"
                                            data-bs-toggle="modal" data-bs-target="#modalEliminarCategoria"
                                            data-id="@c.Id" data-nombre="@c.Nombre" data-productos="@c.Productos.Count">
                                        Eliminar
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ===== Clasificación de productos ===== -->
<div class="mockup-card">
    <form asp-action="GuardarClasificacion" method="post" id="formClasificacion">
        @Html.AntiForgeryToken()
        <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark">Clasificación de productos</h4>
                <p class="pf-seccion-desc">Los productos sin categoría usan «@nombrePredeterminada» (la categoría por defecto).</p>
            </div>
            @if (Model.Any())
            {
                <div class="d-flex gap-2 flex-wrap align-items-center">
                    <label class="visually-hidden" for="buscarProducto">Buscar producto</label>
                    <input type="search" id="buscarProducto" class="mockup-search-input" placeholder="Buscar código o nombre..." />
                    <label class="visually-hidden" for="filtroCategoria">Filtrar por categoría</label>
                    <select id="filtroCategoria" class="form-select form-select-sm" style="width: auto;">
                        <option value="">Todas las categorías</option>
                        <option value="__defecto">Sin clasificar</option>
                        @foreach (var c in categorias)
                        {
                            <option value="@c.Id">@c.Nombre</option>
                        }
                    </select>
                </div>
            }
        </div>

        @if (Model.Any())
        {
            <div class="pf-aplicar-lote">
                <label for="categoriaLote" class="small fw-semibold mb-0">Cambiar los productos visibles a:</label>
                <select id="categoriaLote" class="form-select form-select-sm" style="width: auto;">
                    <option value="">Sin clasificar (usa «@nombrePredeterminada»)</option>
                    @foreach (var c in categorias)
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
                <button type="button" class="btn-pf-gray" style="padding: 4px 14px; font-size: 14px;" id="btnAplicarLote">Aplicar</button>
            </div>

            <div class="table-responsive">
                <table class="mockup-table" id="tablaProductos">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Ubicaciones</th>
                            <th style="min-width: 210px;">Categoría</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr data-buscar="@($"{p.Codigo} {p.Nombre}".ToLowerInvariant())">
                                <td class="fw-semibold">@p.Codigo</td>
                                <td>@p.Nombre</td>
                                <td>@p.Ubicaciones.Count</td>
                                <td>
                                    <label class="visually-hidden" for="cat-@p.Id">Categoría de @p.Nombre</label>
                                    <select class="form-select form-select-sm pf-select-categoria" id="cat-@p.Id" name="categoria[@p.Id]" data-original="@p.CategoriaProductoId">
                                        <option value="" selected="@(p.CategoriaProductoId == null)">Sin clasificar (usa «@nombrePredeterminada»)</option>
                                        @foreach (var c in categorias)
                                        {
                                            <option value="@c.Id" selected="@(p.CategoriaProductoId == c.Id)">@c.Nombre</option>
                                        }
                                    </select>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn-pf-gray" style="padding: 4px 14px; font-size: 14px;"
                                            data-bs-toggle="modal" data-bs-target="#modalProducto"
                                            data-id="@p.Id" data-codigo="@p.Codigo" data-nombre="@p.Nombre" data-unidades="@p.UnidadesPorCaja" data-ubicaciones="@p.Ubicaciones.Count">
                                        Editar
                                    </button>
                                </td>
                            </tr>
                        }
                        <tr id="filaSinProductos" class="d-none">
                            <td colspan="5" class="text-center text-muted py-3">Ningún producto coincide con el filtro.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="pf-barra-guardar">
                <span id="textoCambios" aria-live="polite">Sin cambios pendientes</span>
                <button type="submit" class="btn-pf-blue" id="btnGuardarClasificacion" disabled>Guardar cambios</button>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                Aún no hay productos. Se crean al registrar ubicaciones en <a asp-controller="Bodegas" asp-action="Index">Bodegas</a>.
            </div>
        }
    </form>
</div>

<!-- Crear / editar categoría -->
<div class="modal fade" id="modalCategoria" tabindex="-1" aria-labelledby="tituloModalCategoria" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="GuardarCategoria" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="categoriaId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark" id="tituloModalCategoria">Nueva categoría</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="categoriaNombre">Nombre</label>
                        <input type="text" class="form-control" id="categoriaNombre" name="nombre" maxlength="50" required placeholder="Ej. Voluminoso / pesado" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="categoriaMinutos">Minutos por unidad</label>
                        <input type="number" class="form-control" id="categoriaMinutos" name="minutosPorUnidad" min="0.01" max="600" step="0.01" required placeholder="Ej. 1.5" />
                        <div class="form-text">Tiempo promedio para recoger una unidad. Acepta decimales, por ejemplo 0.3.</div>
                    </div>
                    <div>
                        <label class="form-label fw-semibold" for="categoriaDescripcion">Descripción <span class="fw-normal text-secondary">(opcional)</span></label>
                        <input type="text" class="form-control" id="categoriaDescripcion" name="descripcion" maxlength="150" placeholder="Ej. Torres de PC, UPS" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-pf-blue">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Editar producto: nombre y cantidad por caja (la categoría se cambia en la tabla) -->
<div class="modal fade" id="modalProducto" tabindex="-1" aria-labelledby="tituloModalProducto" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditarProducto" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="productoId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark" id="tituloModalProducto">Editar producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="small mb-3" style="color: #4B5563;" id="textoModalProducto"></p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="productoNombre">Nombre</label>
                        <input type="text" class="form-control" id="productoNombre" name="nombre" maxlength="150" required />
                    </div>
                    <div>
                        <label class="form-label fw-semibold" for="productoUnidades">Cantidad máx. por caja</label>
                        <input type="number" class="form-control" id="productoUnidades" name="unidadesPorCaja" min="1" max="@Producto.MaxUnidadesPorCaja" step="1" required />
                        <div class="form-text">Unidades que trae la caja o empaque. Usa 1 si se recoge de a una unidad.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-pf-blue">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Confirmar eliminación de categoría -->
<div class="modal fade" id="modalEliminarCategoria" tabindex="-1" aria-labelledby="tituloEliminarCategoria" aria-describedby="textoEliminarCategoria" aria-hidden="true">
    <div class="modal-dialog pf-alert-dialog">
        <div class="modal-content">
            <form asp-action="EliminarCategoria" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="eliminarCategoriaId" />
                <div class="pf-alert-icon" aria-hidden="true" style="color: #DC2626; background-color: rgba(220, 38, 38, 0.1);"><i class="bi bi-trash3"></i></div>
                <h2 class="pf-alert-title" id="tituloEliminarCategoria">¿Eliminar la categoría?</h2>
                <p class="pf-alert-text" id="textoEliminarCategoria"></p>
                <div class="pf-alert-actions">
                    <button type="button" class="pf-alert-btn pf-alert-btn--secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="pf-alert-btn pf-alert-btn--primary" style="background-color: #DC2626;">Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var nombrePredeterminada = @Json.Serialize(nombrePredeterminada);

            // Diálogo de categoría: el mismo formulario sirve para crear y editar
            var modalCategoria = document.getElementById('modalCategoria');
            modalCategoria.addEventListener('show.bs.modal', function (e) {
                var origen = e.relatedTarget;
                var editar = origen && origen.dataset.modo === 'editar';
                document.getElementById('tituloModalCategoria').textContent = editar ? 'Editar categoría' : 'Nueva categoría';
                document.getElementById('categoriaId').value = editar ? origen.dataset.id : '';
                document.getElementById('categoriaNombre').value = editar ? origen.dataset.nombre : '';
                document.getElementById('categoriaMinutos').value = editar ? origen.dataset.minutos : '';
                document.getElementById('categoriaDescripcion').value = editar ? (origen.dataset.descripcion || '') : '';
            });
            modalCategoria.addEventListener('shown.bs.modal', function () {
                document.getElementById('categoriaNombre').focus();
            });

            // Diálogo de producto: el código no cambia; el nombre aplica en todas sus ubicaciones
            var modalProducto = document.getElementById('modalProducto');
            modalProducto.addEventListener('show.bs.modal', function (e) {
                var origen = e.relatedTarget;
                var ubicaciones = parseInt(origen.dataset.ubicaciones, 10) || 0;
                document.getElementById('tituloModalProducto').textContent = 'Editar ' + origen.dataset.codigo;
                document.getElementById('textoModalProducto').textContent = ubicaciones > 1
                    ? 'Los cambios se verán en sus ' + ubicaciones + ' ubicaciones.'
                    : 'El código del producto no cambia.';
                document.getElementById('productoId').value = origen.dataset.id;
                document.getElementById('productoNombre').value = origen.dataset.nombre;
                document.getElementById('productoUnidades').value = origen.dataset.unidades;
            });
            modalProducto.addEventListener('shown.bs.modal', function () {
                document.getElementById('productoNombre').focus();
            });

            var modalEliminar = document.getElementById('modalEliminarCategoria');
            modalEliminar.addEventListener('show.bs.modal', function (e) {
                var origen = e.relatedTarget;
                var n = parseInt(origen.dataset.productos, 10) || 0;
                document.getElementById('eliminarCategoriaId').value = origen.dataset.id;
                document.getElementById('tituloEliminarCategoria').textContent = '¿Eliminar «' + origen.dataset.nombre + '»?';
                document.getElementById('textoEliminarCategoria').textContent = n === 0
                    ? 'No tiene productos asignados.'
                    : (n === 1 ? 'Su producto pasará' : 'Sus ' + n + ' productos pasarán') + ' a usar «' + nombrePredeterminada + '», la categoría por defecto.';
            });

            // Clasificación de productos: cambios pendientes, filtro y aplicación en lote
            var form = document.getElementById('formClasificacion');
            var tabla = document.getElementById('tablaProductos');
            if (!tabla) return;
            var selects = Array.prototype.slice.call(tabla.querySelectorAll('.pf-select-categoria'));
            var btnGuardar = document.getElementById('btnGuardarClasificacion');
            var textoCambios = document.getElementById('textoCambios');
            var buscar = document.getElementById('buscarProducto');
            var filtroCategoria = document.getElementById('filtroCategoria');
            var sinProductos = document.getElementById('filaSinProductos');
            var enviando = false;

            function pendientes() {
                return selects.filter(function (s) { return s.value !== (s.dataset.original || ''); }).length;
            }

            function actualizarCambios() {
                selects.forEach(function (s) {
                    s.closest('tr').classList.toggle('pf-fila-modificada', s.value !== (s.dataset.original || ''));
                });
                var n = pendientes();
                btnGuardar.disabled = n === 0;
                btnGuardar.textContent = n === 0 ? 'Guardar cambios' : (n === 1 ? 'Guardar 1 cambio' : 'Guardar ' + n + ' cambios');
                textoCambios.textContent = n === 0 ? 'Sin cambios pendientes' : (n === 1 ? '1 producto modificado' : n + ' productos modificados');
            }

            function filasVisibles() {
                return selects.map(function (s) { return s.closest('tr'); }).filter(function (f) { return !f.classList.contains('d-none'); });
            }

            function filtrar() {
                var t = buscar.value.trim().toLowerCase();
                var cat = filtroCategoria.value;
                var visibles = 0;
                selects.forEach(function (s) {
                    var fila = s.closest('tr');
                    var coincideCat = cat === '' || (cat === '__defecto' ? s.value === '' : s.value === cat);
                    var mostrar = fila.dataset.buscar.indexOf(t) !== -1 && coincideCat;
                    fila.classList.toggle('d-none', !mostrar);
                    if (mostrar) visibles++;
                });
                sinProductos.classList.toggle('d-none', visibles > 0);
            }

            tabla.addEventListener('change', function (e) {
                if (e.target.classList.contains('pf-select-categoria')) actualizarCambios();
            });
            buscar.addEventListener('input', filtrar);
            filtroCategoria.addEventListener('change', filtrar);

            document.getElementById('btnAplicarLote').addEventListener('click', function () {
                var valor = document.getElementById('categoriaLote').value;
                filasVisibles().forEach(function (f) {
                    var s = f.querySelector('.pf-select-categoria');
                    s.value = valor;
                });
                actualizarCambios();
            });

            form.addEventListener('submit', function () { enviando = true; });

            // Evita perder la clasificación si se sale de la página sin guardar
            window.addEventListener('beforeunload', function (e) {
                if (!enviando && pendientes() > 0) {
                    e.preventDefault();
                    e.returnValue = '';
                }
            });

            actualizarCambios();
        })();
    </script>
}
