@model PickingApp.Models.Empleado
@{
    ViewData["Title"] = "Editar empleado";
    var nombres = "";
    var apellidos = "";
    // Si el servidor rechaza el formulario, nombres y apellidos vuelven tal como se escribieron
    if (Context.Request.HasFormContentType)
    {
        nombres = Context.Request.Form["nombres"].ToString();
        apellidos = Context.Request.Form["apellidos"].ToString();
    }
    else if (!string.IsNullOrEmpty(Model.NombreCompleto))
    {
        var parts = Model.NombreCompleto.Split(' ', 2);
        nombres = parts[0];
        apellidos = parts.Length > 1 ? parts[1] : "";
    }
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? Roles.Auxiliar;
    var esAdministrador = userRole == Roles.Administrador;
    // Si el POST se rechaza, lo que el usuario escribió en "motivo" vuelve en ModelState
    var motivo = ViewData.ModelState["motivo"]?.AttemptedValue;
}

<h1 class="pf-page-title">Editar empleado</h1>

<div class="pf-card">
    <div class="pf-info-banner">
        Complete la información del empleado. Los campos marcados con * son obligatorios
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="pf-alert-warning mb-4">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Editar" method="post" id="formEmpleado">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Identificacion" />
        <input type="hidden" asp-for="NombreCompleto" id="hiddenNombreCompleto" />

        <div class="row mb-3">
            <div class="col-md-6 pf-form-group">
                <label for="inputNombres" class="pf-label">Nombres <span class="text-danger">*</span></label>
                <input type="text" id="inputNombres" name="nombres" class="pf-input" value="@nombres" required />
            </div>
            <div class="col-md-6 pf-form-group">
                <label for="inputApellidos" class="pf-label">Apellidos <span class="text-danger">*</span></label>
                <input type="text" id="inputApellidos" name="apellidos" class="pf-input" value="@apellidos" required />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 pf-form-group">
                <label for="identificacionActual" class="pf-label">Numero de documento <span class="text-danger">*</span></label>
                <input id="identificacionActual" class="pf-input" value="@Model.Identificacion" disabled style="background-color: var(--pf-hover) !important;" />
            </div>
            <div class="col-md-6 pf-form-group">
                <label for="Correo" class="pf-label">Correo electronico <span class="text-danger">*</span></label>
                <input id="Correo" asp-for="Correo" type="email" class="pf-input" required />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 pf-form-group">
                <label for="FechaIngreso" class="pf-label">Fecha de ingreso <span class="text-danger">*</span></label>
                <input id="FechaIngreso" asp-for="FechaIngreso" type="date" class="pf-input" required />
                <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
            </div>
            @* Solo el Administrador traslada; no se permite con un pedido en curso (EmpleadosController.Editar) *@
            @if (esAdministrador)
            {
                <div class="col-md-6 pf-form-group">
                    <label class="pf-label" for="BodegaId">Bodega <span class="text-danger">*</span></label>
                    <select asp-for="BodegaId" class="pf-input" required>
                        @await Component.InvokeAsync("OpcionesBodega", new { seleccionada = Model.BodegaId })
                    </select>
                    <span asp-validation-for="BodegaId" class="text-danger small"></span>
                </div>
            }
        </div>

        <div class="row mb-4">
            <div class="col-md-3 pf-form-group">
                <label for="HorarioEntrada" class="pf-label">Hora de entrada <span class="text-danger">*</span></label>
                <input id="HorarioEntrada" asp-for="HorarioEntrada" type="time" class="pf-input" required />
                <span asp-validation-for="HorarioEntrada" class="text-danger small"></span>
            </div>
            <div class="col-md-3 pf-form-group">
                <label for="HorarioSalida" class="pf-label">Hora de salida <span class="text-danger">*</span></label>
                <input id="HorarioSalida" asp-for="HorarioSalida" type="time" class="pf-input" required />
                <span asp-validation-for="HorarioSalida" class="text-danger small"></span>
            </div>
        </div>

        @if (!esAdministrador)
        {
            <div class="row mb-4">
                <div class="col-12 pf-form-group">
                    <label for="motivo" class="pf-label">Motivo de la edición <span class="text-danger">*</span></label>
                    <textarea id="motivo" name="motivo" class="pf-input" style="height: 90px;" placeholder="Explique por qué se está modificando este empleado" required>@motivo</textarea>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Index" class="btn-pf-gray" data-pf-volver="ultima">
                Cancelar
            </a>
            <button type="submit" class="btn-pf-blue">
                Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('formEmpleado').addEventListener('submit', function (e) {
            const nom = document.getElementById('inputNombres').value.trim();
            const ape = document.getElementById('inputApellidos').value.trim();
            document.getElementById('hiddenNombreCompleto').value = (nom + ' ' + ape).trim();
        });
    </script>
}
