@model PickingApp.Models.ViewModels.VerificarCodigoCambioViewModel
@{
    ViewData["Title"] = "Verificar código";
}

<h1 class="pf-page-title">Verificar código</h1>

<div class="pf-card" style="max-width: 680px;">
    <p class="text-muted">Te enviamos un código de verificación de 6 dígitos a tu correo registrado. Ingrésalo para confirmar el cambio de contraseña.</p>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="pf-alert-warning mb-4">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="VerificarCodigoCambio" method="post">
        @Html.AntiForgeryToken()

        <div class="pf-form-group mb-4">
            <label asp-for="Codigo" class="pf-label">Código de verificación <span class="text-danger">*</span></label>
            <input asp-for="Codigo" class="pf-input" inputmode="numeric" pattern="\d*" maxlength="6" autocomplete="one-time-code" required />
            <span asp-validation-for="Codigo" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-controller="Home" asp-action="Index" class="btn-pf-gray">
                Cancelar
            </a>
            <button type="submit" class="btn-pf-blue">
                Confirmar cambio
            </button>
        </div>
    </form>
</div>
