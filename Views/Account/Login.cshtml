@model PickingApp.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutLogin";
}

<main class="pf-login-card">
    <h1 class="pf-login-titulo">Iniciar sesión</h1>
    <p class="pf-login-sub">Entra con el correo y la contraseña de tu cuenta de PickFlow.</p>

    @{ var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? new List<string>(); }
    @* Siempre presente (oculto si no hay error): el script del final escribe aquí los errores sin recargar.
       role="alert" hace que el lector de pantalla lo anuncie al cambiar. *@
    <div class="alert alert-danger py-2 small mb-3 pf-login-aviso" id="pfLoginAviso" role="alert" hidden="@(!erroresGenerales.Any())">
        @foreach (var error in erroresGenerales)
        {
            <div>@error</div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 small mb-3" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @* Envía un POST a AccountController.Login; asp-for enlaza cada campo con la propiedad del LoginViewModel.
       AntiForgeryToken agrega el token oculto que valida [ValidateAntiForgeryToken] *@
    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="pfLoginForm" novalidate>
        @Html.AntiForgeryToken()

        <label asp-for="Correo" class="pf-login-etiqueta">Correo</label>
        <div class="pf-login-campo">
            <span class="pf-login-campo-ico"><partial name="_Icono" model='"correo"' /></span>
            <input asp-for="Correo" class="pf-login-input" placeholder="nombre@empresa.com" autocomplete="username" />
        </div>
        <span asp-validation-for="Correo" class="pf-login-error"></span>

        <label asp-for="Password" class="pf-login-etiqueta">Contraseña</label>
        <div class="pf-login-campo">
            <span class="pf-login-campo-ico"><partial name="_Icono" model='"candado"' /></span>
            @* data-pf-mostrar="texto": site.js pone "Mostrar"/"Ocultar" escrito en vez del ojito *@
            <input asp-for="Password" class="pf-login-input" type="password" autocomplete="current-password" data-pf-mostrar="texto" />
        </div>
        <span asp-validation-for="Password" class="pf-login-error"></span>

        <button type="submit" class="btn-pf-login">
            Iniciar sesión
        </button>
    </form>

    <div class="pf-login-separador">
        <span>¿Olvidaste tu contraseña?</span>
    </div>
    <a asp-action="SolicitarRecuperacion" class="btn-pf-login-sec">Recuperar contraseña</a>

    <p class="pf-login-pie">¿Aún no tienes cuenta? Pídela al administrador de tu bodega.</p>
</main>

@section Scripts {
    <script src="~/js/paginas/login.js" asp-append-version="true"></script>
}
