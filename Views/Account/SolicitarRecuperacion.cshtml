@model PickingApp.Models.ViewModels.SolicitarCodigoViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LayoutLogin";
}

<main class="pf-login-card">
    <a class="pf-login-marca" asp-action="Login">Pick<span>Flow</span></a>
    <h1 class="pf-login-titulo">Recuperar contraseña</h1>
    <p class="pf-login-sub">Escribe tu correo y te enviaremos un código para crear una contraseña nueva.</p>

    <form asp-action="SolicitarRecuperacion" method="post">
        @Html.AntiForgeryToken()

        <label asp-for="Correo" class="pf-login-etiqueta">Correo</label>
        <input asp-for="Correo" class="pf-login-input mb-1" placeholder="nombre@empresa.com" autocomplete="email" required />
        <span asp-validation-for="Correo" class="text-danger small d-block mb-2"></span>

        <button type="submit" class="btn-pf-login">
            Enviar código de verificación
        </button>

    </form>
    <p class="pf-login-pie"><a asp-action="Login" class="pf-login-link">Volver a iniciar sesión</a></p>
</main>
