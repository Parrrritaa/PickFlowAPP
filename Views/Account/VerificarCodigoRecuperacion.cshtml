@model PickingApp.Models.ViewModels.VerificarCodigoRecuperacionViewModel
@{
    ViewData["Title"] = "Verificar código";
    Layout = "_LayoutLogin";
}

<div class="pf-login-card">
    <div class="text-center mb-4">
        <h3 class="fw-bold" style="color: #00204A;">Verificar código</h3>
        <p class="text-muted small">
            Si <strong>@Model.Correo</strong> está registrado, te enviamos un código de 6 dígitos.
            Ingrésalo junto con tu nueva contraseña.
        </p>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger small mb-3">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="VerificarCodigoRecuperacion" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Correo" />

        <div class="mb-3 text-start">
            <input asp-for="Codigo" class="pf-login-input" placeholder="Código de verificación" inputmode="numeric" pattern="\d*" maxlength="6" required />
            <span asp-validation-for="Codigo" class="text-danger small"></span>
        </div>

        <div class="mb-3 text-start">
            <input asp-for="NewPassword" type="password" class="pf-login-input" placeholder="Nueva contraseña" required />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <div class="mb-3 text-start">
            <input asp-for="ConfirmPassword" type="password" class="pf-login-input" placeholder="Confirmar nueva contraseña" required />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn-pf-login">
            Restablecer contraseña
        </button>

        <div class="mt-2">
            <a asp-action="SolicitarRecuperacion" class="pf-login-link">Reenviar código</a>
        </div>
    </form>
</div>
