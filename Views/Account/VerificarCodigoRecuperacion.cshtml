@model PickingApp.Models.ViewModels.VerificarCodigoRecuperacionViewModel
@{
    ViewData["Title"] = "Verificar código";
    Layout = "_LayoutLogin";
}

<main class="pf-login-card">
    <a class="pf-login-marca" asp-action="Login">Pick<span>Flow</span></a>
    <h1 class="pf-login-titulo">Verificar código</h1>
    <p class="pf-login-sub">
        Si <strong>@Model.Correo</strong> está registrado, te enviamos un código de 6 dígitos.
        Escríbelo junto con tu contraseña nueva.
    </p>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger small mb-3">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="VerificarCodigoRecuperacion" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Correo" />

        <label asp-for="Codigo" class="pf-login-etiqueta">Código de verificación</label>
        <input asp-for="Codigo" class="pf-login-input mb-1" placeholder="000000" inputmode="numeric" pattern="\d*" maxlength="6" autocomplete="one-time-code" required />
        <span asp-validation-for="Codigo" class="text-danger small d-block mb-2"></span>

        <label asp-for="NewPassword" class="pf-login-etiqueta">Nueva contraseña</label>
        <input asp-for="NewPassword" type="password" class="pf-login-input mb-1" autocomplete="new-password" required />
        <span asp-validation-for="NewPassword" class="text-danger small d-block mb-2"></span>

        <label asp-for="ConfirmPassword" class="pf-login-etiqueta">Confirmar nueva contraseña</label>
        <input asp-for="ConfirmPassword" type="password" class="pf-login-input mb-1" autocomplete="new-password" required />
        <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mb-2"></span>

        <button type="submit" class="btn-pf-login">
            Restablecer contraseña
        </button>

    </form>
    <p class="pf-login-pie">¿No te llegó? <a asp-action="SolicitarRecuperacion" class="pf-login-link">Reenviar código</a></p>
</main>
