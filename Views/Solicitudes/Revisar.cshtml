@model PickingApp.Models.Solicitud
@{
    ViewData["Title"] = "Revisar solicitud";
    var tipoDisplay = TiposSolicitud.Nombre(Model.TipoSolicitud);

    // Datos concretos del empleado/ubicación asociados a la solicitud (CU-08 / CU-11 / CU-14 / CU-21).
    var datosEmpleado = new List<(string Etiqueta, string Valor)>();
    var cambiosEmpleado = new List<CambioSolicitud>();
    var motivo = "No especificado";
    var esEdicion = Model.TipoSolicitud is TiposSolicitud.EdicionEmpleado or TiposSolicitud.EdicionUbicacion;

    switch (Model.TipoSolicitud)
    {
        case TiposSolicitud.RegistroEmpleado:
            var registro = Model.LeerDatos<DatosEmpleadoSolicitud>();
            datosEmpleado.Add(("Número de documento", registro.Identificacion));
            datosEmpleado.Add(("Nombre completo", registro.NombreCompleto));
            if (registro.Correo != null) datosEmpleado.Add(("Correo electrónico", registro.Correo));
            datosEmpleado.Add(("Fecha de ingreso", registro.FechaIngreso.ToString("dd/MM/yyyy")));
            datosEmpleado.Add(("Hora de entrada", registro.HorarioEntrada.ToString(@"hh\:mm")));
            datosEmpleado.Add(("Hora de salida", registro.HorarioSalida.ToString(@"hh\:mm")));
            motivo = "Solicitud de registro de nuevo empleado.";
            break;
        case TiposSolicitud.EdicionEmpleado:
            var edicionEmpleado = Model.LeerDatos<SolicitudEdicionEmpleado>();
            cambiosEmpleado = edicionEmpleado.Cambios;
            motivo = edicionEmpleado.Motivo;
            break;
        case TiposSolicitud.EdicionUbicacion:
            var edicionUbicacion = Model.LeerDatos<SolicitudEdicionUbicacion>();
            cambiosEmpleado = edicionUbicacion.Cambios;
            motivo = edicionUbicacion.Motivo;
            break;
        case TiposSolicitud.InactivacionEmpleado:
            var inactivacion = Model.LeerDatos<SolicitudInactivacionEmpleado>();
            datosEmpleado.Add(("Número de documento", inactivacion.Identificacion));
            datosEmpleado.Add(("Nombre completo", inactivacion.NombreCompleto));
            motivo = inactivacion.Motivo;
            break;
        case TiposSolicitud.EliminacionUbicacion:
            var eliminacion = Model.LeerDatos<SolicitudEliminacionUbicacion>();
            datosEmpleado.Add(("Ubicación", eliminacion.CodigoUbicacion));
            if (eliminacion.BodegaCodigo != null) datosEmpleado.Add(("Bodega", eliminacion.BodegaCodigo));
            motivo = eliminacion.Motivo;
            break;
    }
    if (string.IsNullOrWhiteSpace(motivo)) motivo = "No especificado";
}

<h1 class="pf-page-title">Revisar solicitud</h1>

<div class="mockup-card">
    <div class="mb-4">
        <h4 class="fw-bold text-dark mb-1">Solicitud SOL-@Model.Id</h4>
        <div class="text-secondary fw-medium">@tipoDisplay</div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="bg-white rounded-3 p-3 shadow-sm">
                <div class="text-secondary small fw-medium">Solicitante</div>
                <div class="fs-5 text-dark fw-normal mt-1">@(Model.UsuarioSolicitante?.NombreCompleto ?? "Usuario no disponible")</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="bg-white rounded-3 p-3 shadow-sm">
                <div class="text-secondary small fw-medium">Fecha de solicitud</div>
                <div class="fs-5 text-dark fw-normal mt-1">@Model.FechaSolicitud.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="bg-white rounded-3 p-3 shadow-sm">
                <div class="text-secondary small fw-medium">Tipo de solicitud</div>
                <div class="fs-5 text-dark fw-normal mt-1">@tipoDisplay</div>
            </div>
        </div>
    </div>

    @if (datosEmpleado.Any())
    {
        <div class="mb-4">
            <h5 class="fw-bold text-dark mb-2">Datos a registrar</h5>
            <div class="row g-3">
                @foreach (var dato in datosEmpleado)
                {
                    <div class="col-md-6">
                        <div class="bg-white rounded-3 p-3 shadow-sm">
                            <div class="text-secondary small fw-medium">@dato.Etiqueta</div>
                            <div class="fs-5 text-dark fw-normal mt-1">@dato.Valor</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (cambiosEmpleado.Any())
    {
        <div class="mb-4">
            <h5 class="fw-bold text-dark mb-2">Cambios solicitados</h5>
            <div class="table-responsive">
                <table class="mockup-table">
                    <thead>
                        <tr>
                            <th>Campo</th>
                            <th>Valor anterior</th>
                            <th>Valor nuevo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in cambiosEmpleado)
                        {
                            <tr>
                                <td class="fw-semibold">@c.Campo</td>
                                <td>@c.Anterior</td>
                                <td>@c.Nuevo</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (esEdicion)
    {
        <div class="mockup-info-banner mb-4">
            No se detectaron cambios en los campos @(Model.TipoSolicitud == TiposSolicitud.EdicionEmpleado ? "del empleado" : "de la ubicación").
        </div>
    }

    <div class="mb-4">
        <h5 class="fw-bold text-dark mb-2">Motivo / descripción</h5>
        <div class="mockup-info-banner mb-0">
            @motivo
        </div>
    </div>

    @if (Model.Estado == EstadosSolicitud.Pendiente)
    {
        <form id="formAccionSolicitud" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="mb-4">
                <h5 class="fw-bold text-dark mb-2">Comentario de revisión</h5>
                <textarea name="motivoRechazo" id="txtComentario" class="mockup-input" style="height: 90px;"></textarea>
            </div>

            <div class="d-flex flex-wrap gap-3">
                <button type="submit" formaction="@Url.Action("Aprobar")" class="btn-pf-blue" style="background-color: #84CC16;">
                    Aprobar solicitud
                </button>
                <button type="submit" formaction="@Url.Action("Rechazar")" class="btn-pf-blue" style="background-color: #EF4444;">
                    Rechazar solicitud
                </button>
                <a asp-action="Index" class="btn-pf-gray ms-auto">
                    Volver
                </a>
            </div>
        </form>
    }
    else
    {
        <div class="mockup-alert-warning mb-4">
            Esta solicitud ya fue atendida con estado: <strong>@Model.Estado</strong>
        </div>
        <div>
            <a asp-action="Index" class="btn-pf-gray">
                Volver
            </a>
        </div>
    }
</div>
