@model IEnumerable<PickingApp.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios y roles";
}

<h1 class="pf-page-title">Usuarios y roles</h1>

<div class="pf-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h4 class="fw-bold mb-0" style="color: var(--pf-ink);">Usuarios registrados</h4>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (Model != null && Model.Any())
            {
                @* Filtra la tabla al escribir (site.js, data-pf-buscar-en) *@
                <label class="visually-hidden" for="buscarUsuario">Buscar usuario</label>
                <input type="search" id="buscarUsuario" class="pf-search-input" placeholder="Buscar correo, nombre o rol..." data-pf-buscar-en="tablaUsuarios" autocomplete="off" />
            }
            <a asp-action="Crear" class="btn-pf-blue">
                + Nuevo usuario
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="pf-table" id="tablaUsuarios" data-pf-paginar>
            <thead>
                <tr>
                    <th>Correo</th>
                    <th>Nombre</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@u.Correo</td>
                            <td>@u.NombreCompleto</td>
                            <td>@u.NombreRol</td>
                            <td>@(u.CorreoVerificado ? u.Estado : "No verificado")</td>
                            <td class="text-center">
                                <div class="d-flex gap-2 justify-content-center">
                                    <a asp-action="Editar" asp-route-id="@u.Id" class="btn-pf-blue" style="padding: 4px 20px; font-size: 14px;">
                                        Editar
                                    </a>
                                    @if (u.Estado == EstadosUsuario.Bloqueado)
                                    {
                                        <form asp-action="Desbloquear" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Desbloquear</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No hay usuarios registrados.</td>
                    </tr>
                }
                <tr class="d-none" data-pf-sin-resultados>
                    <td colspan="5" class="text-center text-muted py-4">Ningún usuario coincide con la búsqueda.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>