@model IEnumerable<PickingApp.Models.Usuario>
@{
    // El Supervisor solo ve a los auxiliares de su bodega (UsuariosController.DelAlcance)
    var esAdmin = User.IsInRole(Roles.Administrador);
    ViewData["Title"] = esAdmin ? "Usuarios y roles" : "Auxiliares de tu bodega";
    var columnas = esAdmin ? 6 : 4;
}

<h1 class="pf-page-title">@ViewData["Title"]</h1>

<div class="pf-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h4 class="fw-bold mb-0" style="color: var(--pf-ink);">@(esAdmin ? "Usuarios registrados" : "Auxiliares registrados")</h4>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (Model != null && Model.Any())
            {
                @* Filtra la tabla al escribir (site.js, data-pf-buscar-en) *@
                <label class="visually-hidden" for="buscarUsuario">Buscar usuario</label>
                <input type="search" id="buscarUsuario" class="pf-search-input" placeholder="@(esAdmin ? "Buscar correo, nombre, rol o bodega..." : "Buscar correo o nombre...")" data-pf-buscar-en="tablaUsuarios" autocomplete="off" />
            }
            <a asp-action="Crear" class="btn-pf-blue">
                @(esAdmin ? "+ Nuevo usuario" : "+ Nuevo auxiliar")
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="pf-table" id="tablaUsuarios" data-pf-paginar>
            <thead>
                <tr>
                    <th>Correo</th>
                    <th>Nombre</th>
                    @if (esAdmin)
                    {
                        <th>Rol</th>
                        <th>Bodega</th>
                    }
                    <th>Estado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@u.Correo</td>
                            <td>@u.NombreCompleto</td>
                            @if (esAdmin)
                            {
                                <td>@u.NombreRol</td>
                                <td>@(u.Bodega?.Nombre ?? (u.RolId == Roles.IdAdministrador ? "Todas" : "Sin asignar"))</td>
                            }
                            <td>@(u.CorreoVerificado ? u.Estado : "No verificado")</td>
                            <td class="text-center">
                                <div class="d-flex gap-2 justify-content-center">
                                    <a asp-action="Editar" asp-route-id="@u.Id" class="btn-pf-blue" style="padding: 4px 20px; font-size: 14px;">
                                        Editar
                                    </a>
                                    @if (u.Estado == EstadosUsuario.Bloqueado)
                                    {
                                        <form asp-action="Desbloquear" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Desbloquear</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@columnas" class="text-center text-muted py-4">@(esAdmin ? "No hay usuarios registrados." : "Aún no hay auxiliares en tu bodega.")</td>
                    </tr>
                }
                <tr class="d-none" data-pf-sin-resultados>
                    <td colspan="@columnas" class="text-center text-muted py-4">Ningún usuario coincide con la búsqueda.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>