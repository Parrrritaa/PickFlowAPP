@model PickingApp.Models.ViewModels.UsuarioCampos
@{
    // El Supervisor solo crea auxiliares de su bodega (UsuariosController fija rol y bodega)
    var esAdmin = User.IsInRole(Roles.Administrador);
    ViewData["Title"] = esAdmin ? "Nuevo usuario" : "Nuevo auxiliar";
}

<h1 class="pf-page-title">@ViewData["Title"]</h1>

<div class="pf-card">
    <div class="pf-info-banner">
        @(esAdmin ? "Los usuarios tendrán acceso al sistema según el rol asignado." : "El auxiliar quedará en tu bodega, con acceso a lo que permite el rol Auxiliar.")
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="pf-alert-warning mb-4">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Crear" method="post">
        @Html.AntiForgeryToken()

        <div class="row mb-3">
            <div class="col-md-6 pf-form-group">
                <label for="Correo" class="pf-label">Correo electronico <span class="text-danger">*</span></label>
                <input id="Correo" asp-for="Correo" type="email" class="pf-input" placeholder="" required
                       data-pf-correo-disponible="@Url.Action("CorreoDisponible")" />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>
            <div class="col-md-6 pf-form-group">
                <label for="NombreCompleto" class="pf-label">Nombre completo <span class="text-danger">*</span></label>
                <input id="NombreCompleto" asp-for="NombreCompleto" class="pf-input" placeholder="" required />
                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 pf-form-group">
                <label for="Identificacion" class="pf-label">Número de identificación <span class="text-danger">*</span></label>
                <input id="Identificacion" asp-for="Identificacion" class="pf-input" inputmode="numeric" pattern="\d*" title="Solo números" required />
                <span asp-validation-for="Identificacion" class="text-danger small"></span>
            </div>
        </div>

        @if (esAdmin)
        {
            <div class="row mb-3">
                <div class="col-md-6 pf-form-group">
                    <label class="pf-label" for="RolId">Rol <span class="text-danger">*</span></label>
                    <select asp-for="RolId" class="pf-input" required>
                        @foreach (var rol in Roles.Catalogo)
                        {
                            <option value="@rol.Id">@rol.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="RolId" class="text-danger small"></span>
                </div>
                <div class="col-md-6 pf-form-group" data-pf-oculto-si="RolId=@Roles.IdAdministrador">
                    <label class="pf-label" for="BodegaId">Bodega <span class="text-danger">*</span></label>
                    <select asp-for="BodegaId" class="pf-input" required>
                        @await Component.InvokeAsync("OpcionesBodega", new { seleccionada = Model?.BodegaId })
                    </select>
                    <span asp-validation-for="BodegaId" class="text-danger small"></span>
                </div>
            </div>
        }

        <div class="row mb-3">
            <div class="col-md-6 pf-form-group">
                <label for="password" class="pf-label">Contraseña <span class="text-danger">*</span></label>
                <input id="password" type="password" name="password" class="pf-input" autocomplete="new-password" required minlength="6" maxlength="100" pattern="(?=.*[A-Za-z])(?=.*\d).{6,}" title="Al menos 6 caracteres, con al menos una letra y un número" />
            </div>
            <div class="col-md-6 pf-form-group">
                <label for="confirmPassword" class="pf-label">Confirmar contraseña <span class="text-danger">*</span></label>
                <input id="confirmPassword" type="password" name="confirmPassword" class="pf-input" autocomplete="new-password" required data-pf-igual="password" />
            </div>
        </div>

        <div class="row mb-4 align-items-center">
            <div class="col-md-6 pf-form-group">
                <label for="Estado" class="pf-label">Estado <span class="text-danger">*</span></label>
                <select id="Estado" asp-for="Estado" class="pf-input">
                    @foreach (var estado in EstadosUsuario.Todos)
                    {
                        <option value="@estado">@estado</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <div class="pf-alert-warning mt-2 mb-0" style="font-size: 13px; font-weight: normal;">
                    La contraseña asignada es temporal; el usuario podrá cambiarla cuando lo desee desde la opción 'Cambiar contraseña', después de iniciar sesión.
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Index" class="btn-pf-gray" data-pf-volver="ultima">
                Cancelar
            </a>
            <button type="submit" class="btn-pf-blue">
                @(esAdmin ? "Crear usuario" : "Crear auxiliar")
            </button>
        </div>
    </form>
</div>