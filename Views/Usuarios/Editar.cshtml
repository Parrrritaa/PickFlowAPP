@model PickingApp.Models.Usuario
@using PickingApp.Services
@{
    var esAdmin = User.IsInRole(Roles.Administrador);
    ViewData["Title"] = esAdmin ? "Editar usuario" : "Editar auxiliar";
    // El propio rol y estado no se cambian aquí (UsuariosController.Editar lo rechaza)
    var esUnoMismo = Model.Id == User.IdUsuario();
}

<h1 class="pf-page-title">@ViewData["Title"]</h1>

<div class="pf-card">
    <form asp-action="Editar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="row mb-3">
            <div class="col-md-6 pf-form-group">
                <label class="pf-label">Correo electrónico <span class="text-danger">*</span></label>
                <input type="text" class="pf-input" value="@Model.Correo" disabled style="background-color: var(--pf-hover) !important;" />
            </div>
            <div class="col-md-6 pf-form-group">
                <label class="pf-label">Nombre completo <span class="text-danger">*</span></label>
                <input type="text" name="nombreCompleto" class="pf-input" value="@Model.NombreCompleto" maxlength="100" required />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 pf-form-group">
                <label class="pf-label">Número de identificación <span class="text-danger">*</span></label>
                <input type="text" name="identificacion" class="pf-input" value="@Model.Identificacion" maxlength="30" inputmode="numeric" pattern="\d*" title="Solo números" required />
            </div>
        </div>

        @* El Supervisor no ve rol ni bodega: solo el Administrador asciende o traslada (UsuariosController.Editar los ignora) *@
        @if (esAdmin)
        {
            <div class="row mb-3">
                <div class="col-md-6 pf-form-group">
                    <label class="pf-label" for="rolId">Rol <span class="text-danger">*</span></label>
                    <select name="rolId" id="rolId" class="pf-input" required disabled="@esUnoMismo">
                        @foreach (var rol in Roles.Catalogo)
                        {
                            <option value="@rol.Id" selected="@(Model.RolId == rol.Id)">@rol.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 pf-form-group" data-pf-oculto-si="rolId=@Roles.IdAdministrador">
                    <label class="pf-label" for="bodegaId">Bodega <span class="text-danger">*</span></label>
                    <select name="bodegaId" id="bodegaId" class="pf-input" required>
                        @await Component.InvokeAsync("OpcionesBodega", new { seleccionada = Model.BodegaId })
                    </select>
                </div>
            </div>
        }

        <div class="row mb-4">
            <div class="col-md-6 pf-form-group">
                <label class="pf-label">Estado <span class="text-danger">*</span></label>
                <select name="estado" class="pf-input" required disabled="@esUnoMismo">
                    @foreach (var estado in EstadosUsuario.Todos)
                    {
                        <option value="@estado" selected="@(Model.Estado == estado)">@estado</option>
                    }
                </select>
            </div>
        </div>

        @if (esUnoMismo)
        {
            <input type="hidden" name="rolId" value="@Model.RolId" />
            <input type="hidden" name="estado" value="@Model.Estado" />
            <div class="pf-alert-warning mb-4" style="font-weight: normal;">
                Tu propio rol y tu estado solo los puede cambiar otro Administrador.
            </div>
        }
        else if (esAdmin)
        {
            <div class="pf-alert-warning mb-4" style="font-weight: normal;">
                Cambiar el rol modificará los módulos y permisos disponibles para este usuario. Cambiar la bodega lo traslada: verá solo lo de la bodega nueva.
            </div>
        }

        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Index" class="btn-pf-gray">
                Cancelar
            </a>
            <button type="submit" class="btn-pf-blue">
                Guardar cambios
            </button>
        </div>
    </form>
</div>