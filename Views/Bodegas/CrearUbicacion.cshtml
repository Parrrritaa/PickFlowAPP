@model PickingApp.Models.ViewModels.UbicacionFormViewModel
@{
    ViewData["Title"] = "Crear ubicación";
}

<h1 class="pf-page-title">Crear ubicación</h1>

<div class="pf-card">
    <div class="pf-info-banner">
        Complete la información de la ubicación que desea registrar en el sistema.
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="pf-alert-warning mb-3">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="CrearUbicacion" asp-route-bodegaId="@Model.Bodega.Id" method="post">
        @Html.AntiForgeryToken()
        <partial name="_CamposUbicacion" model="Model" />

        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Detalle" asp-route-id="@Model.Bodega.Id" class="btn-pf-gray" data-pf-volver="ultima">
                Cancelar
            </a>
            <button type="submit" class="btn-pf-blue">
                Crear ubicación
            </button>
        </div>
    </form>
</div>
