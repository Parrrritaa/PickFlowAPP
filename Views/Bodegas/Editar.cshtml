@model PickingApp.Models.Bodega
@{
    ViewData["Title"] = "Editar bodega";
}

<h1 class="pf-page-title">Editar bodega</h1>

<div class="pf-card">
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="pf-alert-warning mb-4">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Codigo" />
        <input type="hidden" asp-for="FechaCreacion" />

        <div class="pf-info-banner mb-3" style="font-size: 13px;">
            Código de bodega: <strong>@Model.Codigo</strong> (no editable).
        </div>

        <div class="row mb-3">
            <div class="col-12 pf-form-group">
                <label for="Nombre" class="pf-label">Nombre de la bodega <span class="text-danger">*</span></label>
                <input id="Nombre" asp-for="Nombre" class="pf-input" required />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6 pf-form-group">
                <label for="Activa" class="pf-label">Estado</label>
                <select id="Activa" asp-for="Activa" class="pf-input">
                    <option value="true">Activa</option>
                    <option value="false">Inactiva</option>
                </select>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12 pf-form-group">
                <label for="Descripcion" class="pf-label">Descripción</label>
                <textarea id="Descripcion" asp-for="Descripcion" class="pf-input" style="height: 110px;"></textarea>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Index" class="btn-pf-gray" data-pf-volver="ultima">
                Cancelar
            </a>
            <button type="submit" class="btn-pf-blue">
                Guardar cambios
            </button>
        </div>
    </form>
</div>
