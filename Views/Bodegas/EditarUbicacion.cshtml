@model PickingApp.Models.Ubicacion
@{
    var bodega = ViewBag.Bodega as PickingApp.Models.Bodega;
    var motivo = ViewBag.Motivo as string;
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? Roles.Auxiliar;
    var esAdministrador = userRole == Roles.Administrador;

    ViewData["Title"] = "Editar ubicación";
}

<h1 class="pf-page-title">Editar ubicación</h1>

<div class="mockup-card">
    <div class="mockup-info-banner">
        @(esAdministrador
            ? "Modifique la información de la ubicación. Los cambios se aplican de inmediato."
            : "Modifique la información de la ubicación. La solicitud quedará pendiente de aprobación del Administrador.")
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mockup-alert-warning mb-3">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="EditarUbicacion" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BodegaId" />

        <div class="row mb-3">
            <div class="col-md-12 mockup-form-group">
                <label class="mockup-label">Bodega</label>
                <input type="text" class="mockup-input" value="@(bodega?.Nombre ?? "Sin bodega")" disabled style="background-color: #E5E7EB !important;" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4 mockup-form-group">
                <label class="mockup-label">Pasillo <span class="text-danger">*</span></label>
                <input asp-for="Pasillo" class="mockup-input" placeholder="1" inputmode="numeric" pattern="\d*" title="Solo números" required />
                <span asp-validation-for="Pasillo" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mockup-form-group">
                <label class="mockup-label">Estante <span class="text-danger">*</span></label>
                <input asp-for="Estante" class="mockup-input" placeholder="1" inputmode="numeric" pattern="\d*" title="Solo números" required />
                <span asp-validation-for="Estante" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mockup-form-group">
                <label class="mockup-label">Nivel <span class="text-danger">*</span></label>
                <input asp-for="Nivel" class="mockup-input" placeholder="1" inputmode="numeric" pattern="\d*" title="Solo números" required />
                <span asp-validation-for="Nivel" class="text-danger small"></span>
            </div>
        </div>

        <div class="mockup-info-banner mb-3" style="font-size: 13px;">
            El código de la ubicación se genera automáticamente a partir de estos datos (ej: <strong>PAS01-EST02-NIV03</strong>). Código actual: <strong>@Model.CodigoUbicacion</strong>.
        </div>

        <partial name="_SeleccionProducto" model="(PickingApp.Models.ViewModels.SeleccionProductoViewModel)ViewBag.SeleccionProducto" />

        <div class="row mb-4">
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Estado</label>
                <select asp-for="Activa" class="mockup-input">
                    <option value="true">Activa</option>
                    <option value="false">Inactiva</option>
                </select>
            </div>
        </div>

        @if (!esAdministrador)
        {
            <div class="row mb-4">
                <div class="col-12 mockup-form-group">
                    <label class="mockup-label">Motivo de la edición <span class="text-danger">*</span></label>
                    <textarea name="motivo" class="mockup-input" style="height: 90px;" placeholder="Explique por qué se está modificando esta ubicación" required>@motivo</textarea>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Detalle" asp-route-id="@Model.BodegaId" class="btn-pf-gray">
                Cancelar
            </a>
            <button type="submit" class="btn-pf-blue">
                Guardar cambios
            </button>
        </div>
    </form>
</div>
