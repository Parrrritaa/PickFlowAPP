@model PickingApp.Models.ViewModels.BodegasIndexViewModel
@{
    ViewData["Title"] = "Bodegas y ubicaciones";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? Roles.Auxiliar;
    var bodegas = Model.Bodegas;
    var filtroEstado = Model.FiltroEstado;
    var busquedaProducto = Model.BusquedaProducto;
    var resultadosProducto = Model.ResultadosProducto;
    var ubicacionesPorBodega = Model.UbicacionesPorBodega;
    var activoEstado = !string.IsNullOrEmpty(filtroEstado);
    var hayBusquedaProducto = !string.IsNullOrWhiteSpace(busquedaProducto);
}

<h1 class="pf-page-title">Bodegas y ubicaciones</h1>

@* Título y buscador en una sola fila, para que la lista de bodegas se vea sin desplazarse *@
<div class="pf-card mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h4 class="fw-bold mb-1" style="color: var(--pf-ink);">Buscar producto</h4>
            <p class="pf-seccion-desc small mb-0">Busca un producto por código o nombre para saber en qué bodega está y qué ubicación tiene.</p>
        </div>
        <form method="get" asp-action="Index" class="d-flex gap-2 flex-wrap">
            @if (activoEstado)
            {
                <input type="hidden" name="estado" value="@filtroEstado" />
            }
            <label class="visually-hidden" for="filtroBusquedaProducto">Buscar producto</label>
            <input id="filtroBusquedaProducto" type="text" name="busquedaProducto" value="@busquedaProducto" class="form-control" style="width: 320px; max-width: 100%;" placeholder="Código o nombre del producto..." />
            <button type="submit" class="btn-pf-blue">Buscar</button>
            @if (hayBusquedaProducto)
            {
                <a asp-action="Index" asp-route-estado="@filtroEstado" class="btn-pf-gray">Limpiar búsqueda</a>
            }
        </form>
    </div>

    @if (hayBusquedaProducto)
    {
        <div class="table-responsive mt-4">
            <table class="pf-table" data-pf-paginar>
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Bodega</th>
                        <th>Ubicación</th>
                    </tr>
                </thead>
                <tbody>
                    @if (resultadosProducto != null && resultadosProducto.Any())
                    {
                        @foreach (var u in resultadosProducto)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @u.Producto!.Codigo
                                    <div class="text-secondary small">@u.Producto.Nombre</div>
                                </td>
                                <td>
                                    @if (u.Bodega != null)
                                    {
                                        <a asp-action="Detalle" asp-route-id="@u.Bodega.Id">@u.Bodega.Nombre</a>
                                        <div class="text-secondary small">@u.Bodega.Codigo</div>
                                    }
                                </td>
                                <td>@u.CodigoUbicacion</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">Ningún producto coincide con «@busquedaProducto».</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="pf-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h4 class="fw-bold mb-0" style="color: var(--pf-ink);">Bodegas registradas</h4>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (bodegas.Any())
            {
                @* Filtra la tabla al escribir (site.js, data-pf-buscar-en); el estado se sigue filtrando en la columna *@
                <label class="visually-hidden" for="buscarBodega">Buscar bodega</label>
                <input type="search" id="buscarBodega" class="pf-search-input" placeholder="Buscar nombre o código..." data-pf-buscar-en="tablaBodegas" autocomplete="off" />
            }
            @if (userRole == Roles.Administrador)
            {
                <a asp-action="Crear" class="btn-pf-blue">
                    + Crear bodega
                </a>
            }
        </div>
    </div>

    <form method="get" asp-action="Index" id="formFiltrosBodegas">
        @if (hayBusquedaProducto)
        {
            <input type="hidden" name="busquedaProducto" value="@busquedaProducto" />
        }
        <div class="table-responsive">
            <table class="pf-table" id="tablaBodegas" data-pf-paginar>
                <thead>
                    <tr>
                        <th>Bodega</th>
                        <th>Ubicaciones</th>
                        <th>
                            <div class="dropdown">
                                <button type="button" class="th-filtro-btn @(activoEstado ? "activo" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                    Estado <i class="bi @(activoEstado ? "bi-funnel-fill" : "bi-funnel")"></i>
                                </button>
                                <div class="dropdown-menu th-filtro-menu">
                                    <label class="visually-hidden" for="filtroEstado">Filtrar por estado</label>
                                    <select id="filtroEstado" name="estado" class="form-select form-select-sm filtro-auto">
                                        <option value="">Todas</option>
                                        <option value="Activa" selected="@(filtroEstado == "Activa")">Activa</option>
                                        <option value="Inactiva" selected="@(filtroEstado == "Inactiva")">Inactiva</option>
                                    </select>
                                </div>
                            </div>
                        </th>
                        <th class="text-center">
                            Acción
                            @if (activoEstado)
                            {
                                <a asp-action="Index" class="d-block small fw-semibold text-decoration-none mt-1">
                                    <i class="bi bi-x-circle"></i> Limpiar filtros
                                </a>
                            }
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (bodegas.Any())
                    {
                        @foreach (var b in bodegas)
                        {
                            var ubicacionesCount = ubicacionesPorBodega.GetValueOrDefault(b.Id);
                            var estadoText = b.Activa ? "Activa" : "Inactiva";

                            <tr>
                                <td class="fw-semibold">
                                    @b.Nombre
                                    <div class="text-secondary small">@b.Codigo</div>
                                </td>
                                <td>@ubicacionesCount</td>
                                <td>@estadoText</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                        <a asp-action="Detalle" asp-route-id="@b.Id" class="btn-pf-blue" data-fila-abre style="padding: 4px 18px; font-size: 14px;">
                                            Ver ubicaciones
                                        </a>
                                        @if (userRole == Roles.Administrador)
                                        {
                                            <a asp-action="Editar" asp-route-id="@b.Id" class="btn-pf-gray" style="padding: 4px 18px; font-size: 14px;">
                                                Editar
                                            </a>
                                            <button type="button" class="btn-pf-gray btn-eliminar-bodega" style="padding: 4px 18px; font-size: 14px;"
                                                    data-bs-toggle="modal" data-bs-target="#modalEliminarBodega"
                                                    data-bodega-id="@b.Id" data-bodega-etiqueta="@($"{b.Nombre} ({b.Codigo})")">
                                                Eliminar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                @(activoEstado ? "Ninguna bodega coincide con el filtro aplicado." : "No hay bodegas registradas.")
                            </td>
                        </tr>
                    }
                    <tr class="d-none" data-pf-sin-resultados>
                        <td colspan="4" class="text-center text-muted py-4">Ninguna bodega coincide con la búsqueda.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </form>
</div>

@if (userRole == Roles.Administrador)
{
    <div class="modal fade" id="modalEliminarBodega" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 border-0 p-2">
                <form asp-action="EliminarBodega" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="eliminarBodegaId" name="id" value="" />
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold text-danger">Eliminar bodega</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Bodega: <strong id="eliminarBodegaNombre"></strong></p>
                        <div class="pf-alert-warning mt-0 mb-0">
                            Solo se puede eliminar si no tiene ubicaciones ni pedidos asociados.
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-pf-red">Confirmar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('.btn-eliminar-bodega').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('eliminarBodegaId').value = btn.dataset.bodegaId;
                document.getElementById('eliminarBodegaNombre').textContent = btn.dataset.bodegaEtiqueta;
            });
        });
    </script>
}

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('formFiltrosBodegas');
            if (!form) return;

            form.querySelectorAll('.th-filtro-btn').forEach(function (btn) {
                new bootstrap.Dropdown(btn, { autoClose: 'outside', popperConfig: { strategy: 'fixed' } });
            });

            form.querySelectorAll('.filtro-auto').forEach(function (el) {
                el.addEventListener('change', function () { form.submit(); });
            });
        })();
    </script>
}
