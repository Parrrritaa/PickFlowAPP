@model PickingApp.Models.Bodega
@{
    ViewData["Title"] = "Crear bodega";
}

<h1 class="pf-page-title">Crear bodega</h1>

<div class="pf-card">
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="pf-alert-warning mb-4">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Crear" method="post">
        @Html.AntiForgeryToken()

        <div class="pf-info-banner mb-3" style="font-size: 13px;">
            El código de la bodega se asignará automáticamente (BOD-01, BOD-02, ...).
        </div>

        <div class="row mb-3">
            <div class="col-12 pf-form-group">
                <label class="pf-label">Nombre de la bodega <span class="text-danger">*</span></label>
                <input asp-for="Nombre" class="pf-input" placeholder="" required />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 pf-form-group">
                <label class="pf-label">Estado</label>
                <select asp-for="Activa" class="pf-input">
                    <option value="true">Activa</option>
                    <option value="false">Inactiva</option>
                </select>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12 pf-form-group">
                <label class="pf-label">Descripción</label>
                <textarea asp-for="Descripcion" class="pf-input" style="height: 110px;"></textarea>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Index" class="btn-pf-gray">
                Cancelar
            </a>
            <button type="submit" class="btn-pf-blue">
                Crear bodega
            </button>
        </div>
    </form>
</div>
