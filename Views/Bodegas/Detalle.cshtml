@model PickingApp.Models.Bodega
@{
    ViewData["Title"] = "Bodegas y ubicaciones";
    var todasBodegas = ViewBag.TodasBodegas as IEnumerable<PickingApp.Models.Bodega> ?? new List<PickingApp.Models.Bodega> { Model };
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Auxiliar";
    var puedeEliminarUbicacion = userRole == "Administrador" || userRole == "Supervisor";
}

<h1 class="pf-page-title">Bodegas y ubicaciones</h1>

<div class="row g-4">
    <!-- Left Column: Bodegas List matching Slide 26 -->
    <div class="col-lg-4">
        <div class="mockup-card h-100">
            <h4 class="fw-bold text-dark mb-4">Bodegas</h4>
            <div class="d-flex flex-column gap-3">
                @foreach (var b in todasBodegas)
                {
                    var isCurrent = b.Id == Model.Id;
                    var bgStyle = isCurrent ? "background-color: #DCE7FA; border: 1px solid #BFDBFE;" : "background-color: #FFFFFF;";
                    var count = b.Ubicaciones?.Count ?? 0;

                    <a asp-action="Detalle" asp-route-id="@b.Id" class="text-decoration-none d-block p-3 rounded-4 shadow-sm" style="@bgStyle">
                        <div class="fw-bold fs-5" style="color: @(isCurrent ? "#1E40AF" : "#1F2937");">@b.Nombre</div>
                        <div class="small fw-semibold" style="color: @(isCurrent ? "#3B82F6" : "#6B7280");">@b.Codigo</div>
                        <div class="small" style="color: @(isCurrent ? "#3B82F6" : "#6B7280");">@count ubicaciones</div>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Ubicaciones Registradas matching Slide 26 -->
    <div class="col-lg-8">
        <div class="mockup-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h4 class="fw-bold text-dark mb-1">@Model.Nombre</h4>
                    <div class="text-secondary small fw-semibold mb-1">@Model.Codigo</div>
                    <div class="text-secondary small">Ubicaciones registradas</div>
                </div>
                @if (puedeEliminarUbicacion)
                {
                    <a asp-action="CrearUbicacion" asp-route-bodegaId="@Model.Id" class="btn-pf-blue">
                        + Crear ubicación
                    </a>
                }
            </div>

            <div class="table-responsive">
                <table class="mockup-table">
                    <thead>
                        <tr>
                            <th>Ubicación</th>
                            <th>Producto</th>
                            @if (puedeEliminarUbicacion)
                            {
                                <th class="text-center">Acción</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Ubicaciones != null && Model.Ubicaciones.Any())
                        {
                            @foreach (var u in Model.Ubicaciones)
                            {
                                <tr>
                                    <td class="fw-semibold">@u.CodigoUbicacion</td>
                                    <td>
                                        @if (u.Producto != null)
                                        {
                                            @($"{u.Producto.Codigo} - {u.Producto.Nombre}")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin producto asignado</span>
                                        }
                                    </td>
                                    @if (puedeEliminarUbicacion)
                                    {
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-2 flex-wrap">
                                                <a asp-action="EditarUbicacion" asp-route-id="@u.Id" class="btn-pf-gray" style="padding: 4px 16px; font-size: 14px;">
                                                    Editar
                                                </a>
                                                <button type="button" class="btn-pf-gray" style="padding: 4px 16px; font-size: 14px;"
                                                        data-bs-toggle="modal" data-bs-target="#modalEliminarUbicacion"
                                                        onclick="document.getElementById('eliminarUbicacionId').value='@u.Id'; document.getElementById('eliminarUbicacionCodigo').innerText='@u.CodigoUbicacion';">
                                                    @(userRole == "Administrador" ? "Eliminar" : "Solicitar eliminación")
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(puedeEliminarUbicacion ? 3 : 2)" class="text-center text-muted py-4">No hay ubicaciones registradas en esta bodega.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (puedeEliminarUbicacion)
{
    <div class="modal fade" id="modalEliminarUbicacion" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 border-0 p-2">
                <form asp-action="EliminarUbicacion" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="eliminarUbicacionId" name="id" value="" />
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold text-danger">
                            @(userRole == "Administrador" ? "Eliminar ubicación" : "Solicitar eliminación de ubicación")
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Ubicación: <strong id="eliminarUbicacionCodigo"></strong></p>
                        @if (userRole == "Administrador")
                        {
                            <div class="mockup-alert-warning mt-0 mb-3">
                                Esta acción eliminará la ubicación directamente. Si tiene pedidos históricos asociados, no podrá eliminarse.
                            </div>
                        }
                        else
                        {
                            <label class="form-label fw-bold">Motivo (obligatorio):</label>
                            <textarea name="motivo" class="form-control" rows="3" required placeholder="Especifique el motivo de la eliminación"></textarea>
                        }
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-pf-blue" style="background-color: #DC2626;">Confirmar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
