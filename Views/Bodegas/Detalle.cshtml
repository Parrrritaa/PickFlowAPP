@model PickingApp.Models.Bodega
@{
    ViewData["Title"] = "Bodegas y ubicaciones";
    var todasBodegas = ViewBag.TodasBodegas as IEnumerable<PickingApp.Models.Bodega> ?? new List<PickingApp.Models.Bodega> { Model };
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Auxiliar";
    var puedeEliminarUbicacion = userRole == "Administrador" || userRole == "Supervisor";
    const int ubicacionesVisibles = 5;
    var ubicacionesOcultas = Math.Max(0, (Model.Ubicaciones?.Count ?? 0) - ubicacionesVisibles);
    var filtroUbicacion = ViewBag.FiltroUbicacion as string;
    var filtroProducto = ViewBag.FiltroProducto as string;
    var activoUbicacion = !string.IsNullOrWhiteSpace(filtroUbicacion);
    var activoProducto = !string.IsNullOrWhiteSpace(filtroProducto);
    var hayFiltros = activoUbicacion || activoProducto;
}

<h1 class="pf-page-title">Bodegas y ubicaciones</h1>

<div class="row g-4">
    <!-- Left Column: Bodegas List matching Slide 26 -->
    <div class="col-lg-4">
        <div class="mockup-card h-100">
            <h4 class="fw-bold text-dark mb-4">Bodegas</h4>
            <div class="d-flex flex-column gap-3">
                @foreach (var b in todasBodegas)
                {
                    var isCurrent = b.Id == Model.Id;
                    var bgStyle = isCurrent ? "background-color: #DCE7FA; border: 1px solid #BFDBFE;" : "background-color: #FFFFFF;";
                    var count = b.Ubicaciones?.Count ?? 0;

                    <a asp-action="Detalle" asp-route-id="@b.Id" class="text-decoration-none d-block p-3 rounded-4 shadow-sm" style="@bgStyle">
                        <div class="fw-bold fs-5" style="color: @(isCurrent ? "#1E40AF" : "#1F2937");">@b.Nombre</div>
                        <div class="small fw-semibold" style="color: @(isCurrent ? "#3B82F6" : "#6B7280");">@b.Codigo</div>
                        <div class="small" style="color: @(isCurrent ? "#3B82F6" : "#6B7280");">@count ubicaciones</div>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Ubicaciones Registradas matching Slide 26 -->
    <div class="col-lg-8">
        <div class="mockup-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h4 class="fw-bold text-dark mb-1">@Model.Nombre</h4>
                    <div class="text-secondary small fw-semibold mb-1">@Model.Codigo</div>
                    <div class="text-secondary small">Ubicaciones registradas</div>
                </div>
                @if (puedeEliminarUbicacion)
                {
                    <a asp-action="CrearUbicacion" asp-route-bodegaId="@Model.Id" class="btn-pf-blue">
                        + Crear ubicación
                    </a>
                }
            </div>

            <form method="get" asp-action="Detalle" id="formFiltrosUbicaciones">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="table-responsive">
                    <table class="mockup-table" id="tablaUbicaciones">
                        <thead>
                            <tr>
                                <th>
                                    <div class="dropdown">
                                        <button type="button" class="th-filtro-btn @(activoUbicacion ? "activo" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                            Ubicación <i class="bi @(activoUbicacion ? "bi-funnel-fill" : "bi-funnel")"></i>
                                        </button>
                                        <div class="dropdown-menu th-filtro-menu">
                                            <label class="form-label small fw-semibold mb-1">Buscar ubicación</label>
                                            <input type="text" name="filtroUbicacion" value="@filtroUbicacion" class="form-control form-control-sm" placeholder="Código de ubicación..." />
                                            <div class="th-filtro-acciones">
                                                <button type="button" class="btn btn-sm btn-link text-secondary" data-limpiar-filtro>Quitar</button>
                                                <button type="submit" class="btn btn-sm btn-primary">Aplicar</button>
                                            </div>
                                        </div>
                                    </div>
                                </th>
                                <th>
                                    <div class="dropdown">
                                        <button type="button" class="th-filtro-btn @(activoProducto ? "activo" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                            Producto <i class="bi @(activoProducto ? "bi-funnel-fill" : "bi-funnel")"></i>
                                        </button>
                                        <div class="dropdown-menu th-filtro-menu">
                                            <label class="form-label small fw-semibold mb-1">Buscar producto</label>
                                            <input type="text" name="filtroProducto" value="@filtroProducto" class="form-control form-control-sm" placeholder="Código o nombre del producto..." />
                                            <div class="th-filtro-acciones">
                                                <button type="button" class="btn btn-sm btn-link text-secondary" data-limpiar-filtro>Quitar</button>
                                                <button type="submit" class="btn btn-sm btn-primary">Aplicar</button>
                                            </div>
                                        </div>
                                    </div>
                                </th>
                                @if (puedeEliminarUbicacion)
                                {
                                    <th class="text-center">
                                        Acción
                                        @if (hayFiltros)
                                        {
                                            <a asp-action="Detalle" asp-route-id="@Model.Id" class="d-block small fw-semibold text-decoration-none mt-1">
                                                <i class="bi bi-x-circle"></i> Limpiar filtros
                                            </a>
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.Ubicaciones != null && Model.Ubicaciones.Any())
                        {
                            var indice = 0;
                            @foreach (var u in Model.Ubicaciones)
                            {
                                <tr class="@(indice++ >= ubicacionesVisibles ? "fila-extra d-none" : "")">
                                    <td class="fw-semibold">@u.CodigoUbicacion</td>
                                    <td>
                                        @if (u.Producto != null)
                                        {
                                            @($"{u.Producto.Codigo} - {u.Producto.Nombre}")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin producto asignado</span>
                                        }
                                    </td>
                                    @if (puedeEliminarUbicacion)
                                    {
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-2 flex-wrap">
                                                <a asp-action="EditarUbicacion" asp-route-id="@u.Id" class="btn-pf-gray" style="padding: 4px 16px; font-size: 14px;">
                                                    Editar
                                                </a>
                                                <button type="button" class="btn-pf-gray" style="padding: 4px 16px; font-size: 14px;"
                                                        data-bs-toggle="modal" data-bs-target="#modalEliminarUbicacion"
                                                        data-pf-id="@u.Id" data-pf-texto="@u.CodigoUbicacion">
                                                    @(userRole == "Administrador" ? "Eliminar" : "Solicitar eliminación")
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(puedeEliminarUbicacion ? 3 : 2)" class="text-center text-muted py-4">
                                    @(hayFiltros ? "Ninguna ubicación coincide con los filtros aplicados." : "No hay ubicaciones registradas en esta bodega.")
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (ubicacionesOcultas > 0)
                {
                    <div class="text-center mt-2">
                        <button type="button" class="btn btn-link fw-semibold text-decoration-none"
                                data-ver-mas="tablaUbicaciones"
                                data-texto-mas="Ver más (@ubicacionesOcultas ubicaciones)" data-texto-menos="Ver menos">
                            Ver más (@ubicacionesOcultas ubicaciones)
                        </button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

@if (puedeEliminarUbicacion)
{
    <div class="modal fade" id="modalEliminarUbicacion" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 border-0 p-2">
                <form asp-action="EliminarUbicacion" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="eliminarUbicacionId" name="id" data-pf-recibe="id" value="" />
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold text-danger">
                            @(userRole == "Administrador" ? "Eliminar ubicación" : "Solicitar eliminación de ubicación")
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Ubicación: <strong id="eliminarUbicacionCodigo" data-pf-recibe="texto"></strong></p>
                        @if (userRole == "Administrador")
                        {
                            <div class="mockup-alert-warning mt-0 mb-3">
                                Esta acción eliminará la ubicación directamente. Si tiene pedidos históricos asociados, no podrá eliminarse.
                            </div>
                        }
                        else
                        {
                            <label class="form-label fw-bold">Motivo (obligatorio):</label>
                            <textarea name="motivo" class="form-control" rows="3" required placeholder="Especifique el motivo de la eliminación"></textarea>
                        }
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-pf-blue" style="background-color: #DC2626;">Confirmar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('formFiltrosUbicaciones');
            if (!form) return;

            form.querySelectorAll('.th-filtro-btn').forEach(function (btn) {
                new bootstrap.Dropdown(btn, { autoClose: 'outside', popperConfig: { strategy: 'fixed' } });
            });

            form.querySelectorAll('.filtro-auto').forEach(function (el) {
                el.addEventListener('change', function () { form.submit(); });
            });

            form.querySelectorAll('[data-limpiar-filtro]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    btn.closest('.th-filtro-menu').querySelectorAll('input').forEach(function (i) { i.value = ''; });
                    form.submit();
                });
            });
        })();
    </script>
}
