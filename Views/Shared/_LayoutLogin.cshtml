@* Plantilla de las pantallas sin sesión (iniciar sesión, recuperar contraseña, base de datos no disponible).
   Detrás del formulario va el plano de una bodega vista desde arriba con la ruta de un pedido. *@
<!DOCTYPE html>
<html lang="es">
<head>
    <partial name="_Cabecera" />
</head>
<body>
    <div class="pf-acceso">
        <svg class="pf-acceso-plano" aria-hidden="true" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none">
            <g class="pf-racks" stroke-width="1.5">
                @for (var x = 120; x <= 1320; x += 150)
                {
                    <rect x="@x" y="150" width="36" height="280" rx="5"></rect>
                    <rect x="@x" y="490" width="36" height="280" rx="5"></rect>
                }
            </g>
            <g class="pf-pasillos" font-size="12" text-anchor="middle">
                <text x="213" y="128">PAS01</text>
                <text x="363" y="128">PAS02</text>
                <text x="513" y="128">PAS03</text>
                <text x="663" y="128">PAS04</text>
                <text x="813" y="128">PAS05</text>
                <text x="963" y="128">PAS06</text>
                <text x="1113" y="128">PAS07</text>
                <text x="1263" y="128">PAS08</text>
            </g>
            <path class="pf-ruta-pedido" pathLength="1" d="M40 830 H213 V460 H513 V110 H813 V460 H1113 V830 H1400"
                  stroke="#EB7D26" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
            <g fill="#EB7D26" stroke-width="4">
                <circle class="pf-parada" style="animation-delay: 0.7s" cx="213" cy="610" r="9"></circle>
                <circle class="pf-parada" style="animation-delay: 1.0s" cx="513" cy="250" r="9"></circle>
                <circle class="pf-parada" style="animation-delay: 1.35s" cx="813" cy="330" r="9"></circle>
                <circle class="pf-parada" style="animation-delay: 1.75s" cx="1113" cy="660" r="9"></circle>
            </g>
        </svg>

        @RenderBody()
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
