@model string
@* Íconos de línea de la Propuesta 2 (trazo 1,75). Uso: <partial name="_Icono" model='"pedidos"' />
   Heredan el color del texto (currentColor) y llenan el contenedor, que les da el tamaño. *@
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Model)
    {
        case "inicio":
            <rect x="3.5" y="3.5" width="7" height="7" rx="1.8"></rect><rect x="13.5" y="3.5" width="7" height="7" rx="1.8"></rect><rect x="3.5" y="13.5" width="7" height="7" rx="1.8"></rect><rect x="13.5" y="13.5" width="7" height="7" rx="1.8"></rect>
            break;
        case "pedidos":
            <rect x="5" y="4" width="14" height="17" rx="2.5"></rect><path d="M9 4V3h6v1"></path><path d="M9 12l2 2 4-4"></path>
            break;
        case "excel":
            <path d="M12 16V4"></path><path d="M7 9l5-5 5 5"></path><path d="M4 20h16"></path>
            break;
        case "solicitudes":
            <path d="M22 12h-6l-2 3h-4l-2-3H2"></path><path d="M5.5 5h13L22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z"></path>
            break;
        case "notificaciones":
            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
            break;
        case "empleados":
            <circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20a6.5 6.5 0 0 1 13 0"></path><path d="M16 4.5a3.5 3.5 0 0 1 0 7"></path><path d="M18 14.5a6.5 6.5 0 0 1 3.5 5.5"></path>
            break;
        case "bodegas":
            <path d="M3 21V9l9-5 9 5v12"></path><path d="M7 21v-8h10v8"></path><path d="M7 17h10"></path>
            break;
        case "productos":
            <path d="M21 8l-9-5-9 5 9 5 9-5z"></path><path d="M3 8v8l9 5 9-5V8"></path><path d="M12 13v8"></path>
            break;
        case "reportes":
            <path d="M4 20V11"></path><path d="M10 20V5"></path><path d="M16 20v-6"></path><path d="M21 20H3"></path>
            break;
        case "usuarios":
            <circle cx="10" cy="8" r="4"></circle><path d="M3 21a7 7 0 0 1 10.5-6"></path><circle cx="18" cy="17" r="2.6"></circle>
            break;
        case "registro":
            <path d="M6 3h11a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6z"></path><path d="M6 3v18"></path><path d="M10 8h5M10 12h5"></path>
            break;
        case "config":
            <circle cx="12" cy="12" r="3"></circle><path d="M12 2.5v3M12 18.5v3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M2.5 12h3M18.5 12h3M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"></path>
            break;
        case "buscar":
            <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
            break;
        case "panel":
            <rect x="3" y="4" width="18" height="16" rx="3"></rect><path d="M9 4v16"></path>
            break;
        case "selector":
            <path d="M8 9l4-4 4 4"></path><path d="M16 15l-4 4-4-4"></path>
            break;
        case "abajo":
            <path d="M6 9l6 6 6-6"></path>
            break;
        case "derecha":
            <path d="M9 6l6 6-6 6"></path>
            break;
        case "llave":
            <circle cx="7.5" cy="15.5" r="4.5"></circle><path d="M10.7 12.3L20 3"></path><path d="M16 7l3 3"></path><path d="M18 5l2 2"></path>
            break;
        case "salir":
            <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3"></path><path d="M10 17l-5-5 5-5"></path><path d="M5 12h11"></path>
            break;
        case "check":
            <path d="M5 12.5l4.5 4.5L19 7.5"></path>
            break;
        default:
            <circle cx="12" cy="12" r="8"></circle>
            break;
    }
</svg>
