<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PickFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Aplica el estado guardado del menú antes de pintar, sin animación, para evitar un salto al cargar.
        (function () {
            var root = document.documentElement;
            root.classList.add('pf-sin-transicion');
            try {
                if (localStorage.getItem('pf-menu') === 'oculto') root.classList.add('pf-sidebar-collapsed');
            } catch (e) { }
        })();
    </script>
</head>
<body class="@(TempData["JustLoggedIn"] != null ? "pf-just-logged-in" : "")">
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Auxiliar";
        var userName = User.Identity.Name ?? "Usuario";
        // Get first name or display name
        var displayName = userName.Contains("@") ? userName.Split('@')[0] : userName;
        displayName = char.ToUpper(displayName[0]) + displayName.Substring(1);

        <aside class="pf-sidebar" id="pfSidebar" aria-label="Menú principal">
            <div>
                <div class="pf-sidebar-top">
                    <a class="pf-sidebar-brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-pick">Pick</span><span class="brand-flow">Flow</span>
                    </a>
                    <button type="button" class="pf-menu-toggle pf-menu-toggle--sidebar" data-menu-toggle
                            aria-controls="pfSidebar" aria-expanded="true" aria-label="Ocultar menú" title="Ocultar menú">
                        <span class="pf-menu-toggle-lines" aria-hidden="true"><span></span><span></span><span></span></span>
                    </button>
                </div>

                <ul class="pf-nav">
                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            Dashboard
                        </a>
                    </li>
                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Pedidos" && currentAction != "CargarExcel" ? "active" : "")" asp-controller="Pedidos" asp-action="Index">
                            Pedidos
                        </a>
                    </li>
                    @if (userRole == "Administrador" || userRole == "Supervisor")
                    {
                        <li class="pf-nav-item">
                            <a class="pf-nav-link @(currentController == "Pedidos" && currentAction == "CargarExcel" ? "active" : "")" asp-controller="Pedidos" asp-action="CargarExcel">
                                Cargar Excel
                            </a>
                        </li>
                    }
                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Empleados" ? "active" : "")" asp-controller="Empleados" asp-action="Index">
                            Empleados
                        </a>
                    </li>
                    <li class="pf-nav-item">
                        @if (userRole == "Auxiliar")
                        {
                            <a class="pf-nav-link @(currentController == "Solicitudes" ? "active" : "")" asp-controller="Solicitudes" asp-action="MisSolicitudes">
                                Solicitudes
                            </a>
                        }
                        else
                        {
                            <a class="pf-nav-link @(currentController == "Solicitudes" ? "active" : "")" asp-controller="Solicitudes" asp-action="Index">
                                Solicitudes
                            </a>
                        }
                    </li>
                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Reportes" ? "active" : "")" asp-controller="Reportes" asp-action="Index">
                            Reportes
                        </a>
                    </li>
                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Notificaciones" ? "active" : "")" asp-controller="Notificaciones" asp-action="Index">
                            Notificaciones
                        </a>
                    </li>

                    @if (userRole == "Administrador")
                    {
                        <li class="pf-nav-item">
                            <a class="pf-nav-link @(currentController == "Usuarios" ? "active" : "")" asp-controller="Usuarios" asp-action="Index">
                                Usuarios y roles
                            </a>
                        </li>
                    }

                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Bodegas" ? "active" : "")" asp-controller="Bodegas" asp-action="Index">
                            Bodegas
                        </a>
                    </li>

                    @if (userRole == "Administrador")
                    {
                        <li class="pf-nav-item">
                            <a class="pf-nav-link @(currentController == "Auditoria" ? "active" : "")" asp-controller="Auditoria" asp-action="Index">
                                Log del sistema
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div class="pf-sidebar-bottom">
                <form asp-controller="Account" asp-action="Logout" method="post" id="pf-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-pf-logout">
                        Cerrar sesión
                    </button>
                </form>
            </div>
        </aside>
        <div class="pf-sidebar-backdrop" id="pfSidebarBackdrop" aria-hidden="true"></div>

        <!-- Confirmación de cierre de sesión (estilo alerta: título, texto breve, Cancelar a la izquierda y la acción a la derecha) -->
        <div class="modal fade" id="pfModalCerrarSesion" tabindex="-1" aria-labelledby="pfCerrarSesionTitulo" aria-describedby="pfCerrarSesionTexto" aria-hidden="true">
            <div class="modal-dialog pf-alert-dialog">
                <div class="modal-content">
                    <div class="pf-alert-icon" aria-hidden="true"><i class="bi bi-box-arrow-right"></i></div>
                    <h2 class="pf-alert-title" id="pfCerrarSesionTitulo">¿Cerrar sesión?</h2>
                    <p class="pf-alert-text" id="pfCerrarSesionTexto">Tendrás que volver a iniciar sesión para seguir usando PickFlow.</p>
                    <div class="pf-alert-actions">
                        <button type="button" class="pf-alert-btn pf-alert-btn--secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="pf-alert-btn pf-alert-btn--primary" id="pfConfirmarCerrarSesion">Cerrar sesión</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="pf-main-wrapper">
            <header class="pf-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="pf-menu-toggle pf-menu-toggle--header" data-menu-toggle
                            aria-controls="pfSidebar" aria-expanded="false" aria-label="Mostrar menú" title="Mostrar menú">
                        <span class="pf-menu-toggle-lines" aria-hidden="true"><span></span><span></span><span></span></span>
                    </button>
                    <div class="pf-user-badge">
                        <span>@displayName</span> | <span>@userRole</span>
                    </div>
                </div>
                <a asp-controller="Account" asp-action="CambiarContrasena" class="btn btn-sm btn-outline-secondary">
                    Cambiar contraseña
                </a>
            </header>

            <main class="pf-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["WarningMessage"] != null)
                {
                    <div class="mockup-alert-warning mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["WarningMessage"]
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <div class="container py-5">
            @RenderBody()
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
