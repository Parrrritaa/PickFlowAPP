@model bool
@using PickingApp.Services
@* Solicitud de traslado del Supervisor. El modelo dice si es de un empleado (true) o de un auxiliar (false). *@
<div class="modal fade" id="modalTraslado" tabindex="-1" aria-labelledby="modalTrasladoTitulo" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 p-2">
            <form asp-controller="Solicitudes" asp-action="SolicitarTraslado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="esEmpleado" value="@(Model ? "true" : "false")" />
                <input type="hidden" name="id" data-pf-recibe="id" value="" />
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" id="modalTrasladoTitulo">Solicitar traslado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>@(Model ? "Empleado" : "Auxiliar"): <strong data-pf-recibe="texto"></strong></p>
                    <label class="form-label fw-bold" for="bodegaDestinoId">Bodega de destino:</label>
                    <select name="bodegaDestinoId" id="bodegaDestinoId" class="form-select mb-3" required>
                        @await Component.InvokeAsync("OpcionesBodega", new { seleccionada = (int?)null, excluida = User.BodegaVisible() })
                    </select>
                    <label class="form-label fw-bold" for="motivoTraslado">Motivo (obligatorio):</label>
                    <textarea name="motivo" id="motivoTraslado" class="form-control" rows="3" required placeholder="Especifique el motivo del traslado"></textarea>
                    <p class="small text-secondary mt-3 mb-0">
                        El Administrador debe aprobarla. Al aprobarse, @(Model ? "sus pedidos se quedan en esta bodega y seguirá" : "seguirá") apareciendo aquí como trasladado.
                    </p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn-pf-gray" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-pf-blue">Enviar solicitud</button>
                </div>
            </form>
        </div>
    </div>
</div>
